//HSMEXTR  JOB (ACCT),'HSM ACTLOG EXTRACT',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*-------------------------------------------------------------------
//* HSMEXTR - EKSTRAKCJA KOMUNIKATOW ARC* Z ACTIVITY LOGOW DFSMSHSM
//*
//* CEL      : PLIKI SYSNAME;GROUPID;LINIA DLA MF-LOAD HSM (REPO
//*            MF-LOADER), PLIK NA KAZDY LOG. URUCHAMIAC 2X DZIENNIE
//*            NA KAZDYM SYSTEMIE, PO ZAKONCZENIU ZADAN HSM
//*            (GODZINY: MF-LOAD HSM --TASK-TIMES).
//* WEJSCIE  : &ACTHLQ..H<HOST>.<LOG>.DYYDDD.THHMMSS (LISTCAT) Z
//*            OSTATNICH &MAXAGE DNI. LOG Z GOTOWYM WYNIKIEM JEST
//*            POMIJANY, NAJNOWSZY LOG KAZDEGO TYPU - OD NOWA (MOZE
//*            BYC AKTYWNY).
//* SYMBOLE  : &SYMLIB(HSMEXT) - REKORD ROBOCZY DFSORT (KROK 2);
//*            POZYCJE TEKSTU LINII LICZONE Z RECFM / LRECL LOGU.
//* WYNIK    : &OUTHLQ..H<HOST>.<LOG>.DYYDDD.THHMMSS, FB 300.
//*            TRANSFER JAKO TEKST DO KATALOGU SYSTEMU NA SERWERZE
//*            (HSM_<SYS>_DIR W .ENV MF-LOADERA); NAZWA PLIKU: DSN +
//*            .TXT, NP. MYHLQ.HSMEXT.HA.BAKLOG.D26316.T000000.TXT
//* PARAMETRY (SET):
//*   SRCLIB  - BIBLIOTEKA REXX (KATALOG SRC/: HSMEXT)
//*   SYMLIB  - BIBLIOTEKA SYMNAMES (KATALOG SYM/: HSMEXT)
//*   MEMLIB  - LISTY KOMUNIKATOW (KATALOG MEMBERS/, ID W KOL. 1-8)
//*   ACTHLQ  - HLQ ACTIVITY LOGOW (SETSYS ACTLOGTYPE(DASD))
//*   HOSTS   - ID HOSTOW HSM NA TYM SYSTEMIE (ODDZIELONE SPACJA)
//*   LOGS    - TYPY LOGOW
//*   MAXAGE  - ILE DNI WSTECZ SZUKAC LOGOW
//*   OUTHLQ  - HLQ WYNIKOW (DO 14 ZNAKOW - DSN DO 44)
//*   TXTOFF  - ILE ZNAKOW PRZED ID KOMUNIKATU W LINII LOGU
//*             (0 = ID OD POCZATKU TEKSTU; DO WERYFIKACJI NA LOGU)
//* KROKI    : EXTRACT - REXX HSMEXT (IKJEFT1B), DFSORT 2X NA LOG.
//*            RC 0 OK, 4 NIC DO EKSTRAKCJI, 8 BLAD (HSMX-E W
//*            SYSTSPRT); KOMUNIKATY DFSORT W SYSOUT / SYMNOUT.
//*-------------------------------------------------------------------
//         SET SRCLIB='MYHLQ.HSMMON.SRC'
//         SET SYMLIB='MYHLQ.HSMMON.SYM'
//         SET MEMLIB='MYHLQ.HSMMON.MEMBERS'
//         SET ACTHLQ='HSMACT'
//         SET HOSTS='A'
//         SET LOGS='MIGLOG BAKLOG DMPLOG CMDLOG ABRLOG'
//         SET MAXAGE=3
//         SET OUTHLQ='MYHLQ.HSMEXT'
//         SET TXTOFF=0
//*
//EXTRACT  EXEC PGM=IKJEFT1B,DYNAMNBR=60,REGION=0M
//SYSEXEC  DD DISP=SHR,DSN=&SRCLIB
//HSMMEM   DD DISP=SHR,DSN=&MEMLIB
//HSMSYM   DD DISP=SHR,DSN=&SYMLIB(HSMEXT)
//SYSTSPRT DD SYSOUT=*
//SYSTSIN  DD *,SYMBOLS=JCLONLY
 %HSMEXT ACTHLQ(&ACTHLQ) -
   HOSTS(&HOSTS) -
   LOGS(&LOGS) -
   OUTHLQ(&OUTHLQ) -
   MAXAGE(&MAXAGE) -
   TXTOFF(&TXTOFF)
/*
