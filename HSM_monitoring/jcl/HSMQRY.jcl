//HSMQRY   JOB (ACCT),'HSM QUERY ACTIVE',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*-------------------------------------------------------------------
//* HSMQRY - SNAPSHOT STANU DFSMSHSM: QUERY ACTIVE (+ QUERY COPYPOOL)
//*
//* CEL      : PLIK SYSNAME;GROUPID;LINIA Z ODPOWIEDZIA HSM DLA
//*            MF-LOAD HSM (PANELE "HSM STATUS" - FUNKCJE HELD /
//*            ACTIVE). URUCHAMIAC CYKLICZNIE (NP. CO 15-60 MIN)
//*            NA KAZDYM SYSTEMIE.
//* WEJSCIE  : ODPOWIEDZ NA F &HSMPROC,QUERY ACTIVE (SDSF REXX,
//*            ISFSLASH); WYMAGA UPRAWNIENIA DO KOMENDY MODIFY
//*            PROCEDURY HSM (OPERCMDS) DLA UZYTKOWNIKA JOBA.
//* SYMBOLE  : -
//* WYNIK    : &OUTHLQ..HSMQRY.H<HOST>.QACTIVE.DYYDDD.THHMMSS, FB 300
//*            (+ .QCOPYPL., GDY CPOOLS NIEPUSTE). TRANSFER JAK DLA
//*            HSMEXTR, NAZWA PLIKU: DSN + .TXT
//* PARAMETRY (SET):
//*   SRCLIB  - BIBLIOTEKA REXX (KATALOG SRC/: HSMQACT)
//*   HSMPROC - NAZWA PROCEDURY (STC) DFSMSHSM
//*   OUTHLQ  - HLQ WYNIKOW (DO 14 ZNAKOW)
//*   HOST    - ID HOSTA HSM DO NAZWY PLIKU (PUSTE = Z ARC0101I)
//*   WAIT    - ILE SEKUND CZEKAC NA ODPOWIEDZI
//*   CPOOLS  - COPY POOLE DLA QUERY COPYPOOL (PUSTE = BEZ)
//* KROKI    : QUERY - REXX HSMQACT (IKJEFT1B). RC 0 OK, 8 BLAD
//*            (HSMQ-E W SYSTSPRT).
//*-------------------------------------------------------------------
//         SET SRCLIB='MYHLQ.HSMMON.SRC'
//         SET HSMPROC='DFHSM'
//         SET OUTHLQ='MYHLQ.HSMEXT'
//         SET HOST='A'
//         SET WAIT=10
//         SET CPOOLS=''
//*
//QUERY    EXEC PGM=IKJEFT1B,DYNAMNBR=20,REGION=0M
//SYSEXEC  DD DISP=SHR,DSN=&SRCLIB
//SYSTSPRT DD SYSOUT=*
//SYSTSIN  DD *,SYMBOLS=JCLONLY
 %HSMQACT PROC(&HSMPROC) -
   OUTHLQ(&OUTHLQ) -
   HOST(&HOST) -
   WAIT(&WAIT) -
   CPOOLS(&CPOOLS)
/*
