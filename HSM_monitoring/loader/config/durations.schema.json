{
  "title": "HSM ARC*: zadania start / koniec (czas trwania)",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "measurement": {
      "default": "MF.HSM.DURATION",
      "type": "string",
      "minLength": 1
    },
    "tasks": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "enabled": {
            "default": true,
            "type": "boolean"
          },
          "start": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^ARC\\d{4}[A-Z]$"
              },
              {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^ARC\\d{4}[A-Z]$"
                }
              }
            ],
            "description": "Komunikat(y) startu"
          },
          "end": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^ARC\\d{4}[A-Z]$"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "description": "Staly status zadania, np. \"OK\", \"TERMINATED\""
                },
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "description": "Staly status",
                      "type": "string",
                      "minLength": 1
                    },
                    "statusFrom": {
                      "description": "Status z wartosci komunikatu konca (tag / pole / sqlite), np. \"status\"",
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                    },
                    "durationFrom": {
                      "description": "Czas trwania z wartosci komunikatu konca (sekundy, np. pole duration \"elapsed\" z ARC0523I) zamiast roznicy czasow",
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                    },
                    "when": {
                      "description": "Komunikat konczy zadanie tylko, gdy wartosci pasuja do regexow, np. {\"function\": \"^AUTOMATIC BACKUP\"}",
                      "type": "object",
                      "propertyNames": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  },
                  "additionalProperties": false
                }
              ]
            },
            "description": "Komunikat konca -> status"
          },
          "key": {
            "default": [],
            "description": "Wartosci parujace start z koncem (oprocz sysname + host_id), np. [\"volser\"]",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            }
          },
          "keyAlias": {
            "default": {},
            "description": "Inna nazwa klucza w danym komunikacie, np. {\"ARC0570I\": {\"volser\": \"scope\"}}",
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^ARC\\d{4}[A-Z]$"
            },
            "additionalProperties": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
              }
            }
          },
          "tags": {
            "description": "Wartosci z komunikatu konca jako tagi punktu (domyslnie = key)",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            }
          },
          "maxHours": {
            "default": 48,
            "description": "Start starszy niz tyle godzin nie jest parowany",
            "type": "number",
            "exclusiveMinimum": 0
          },
          "aggregate": {
            "default": {},
            "description": "Pole punktu (int) -> agregacja komunikatow w oknie zadania, np. volumes, datasets",
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "enum": [
                    "count",
                    "sum",
                    "max"
                  ],
                  "description": "count = liczba komunikatow, sum / max = z wartosci \"value\""
                },
                "msg": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^ARC\\d{4}[A-Z]$"
                    },
                    {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^ARC\\d{4}[A-Z]$"
                      }
                    }
                  ],
                  "description": "Komunikaty w oknie zadania (od startu do konca wlacznie)"
                },
                "value": {
                  "description": "Wartosc do sum / max, np. \"ds_backed_up\"",
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                },
                "when": {
                  "description": "Tylko komunikaty z wartosciami pasujacymi do regexow",
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                  },
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "op",
                "msg"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "start",
          "end"
        ],
        "additionalProperties": false
      },
      "description": "Nazwa zadania (wielkie litery, cyfry, _) -> definicja"
    }
  },
  "required": [
    "tasks"
  ],
  "additionalProperties": false
}
