{
  "$schema": "../hsm-messages.schema.json",
  "member": "HSMSTAT",
  "description": "Mapowanie komunikatow z members/HSMSTAT.txt",
  "messages": {
    "ARC0001I": {
      "description": "Start HSM",
      "pattern": "^DFSMSHSM (?<hsm_version>\\S+) STARTING HOST=(?<host_in_msg>\\S+) IN HOSTMODE=(?<hostmode>\\S+)",
      "ignoreCase": true,
      "extract": {"hsm_version": "sqlite", "host_in_msg": "sqlite", "hostmode": "tag"},
      "constTags": {"event": "STARTING"}
    },
    "ARC0008I": {"description": "Inicjalizacja HSM zakonczona", "constTags": {"event": "INIT_OK"}},
    "ARC0002I": {"description": "Zatrzymanie HSM zakonczone", "constTags": {"event": "SHUTDOWN"}}
  }
}
