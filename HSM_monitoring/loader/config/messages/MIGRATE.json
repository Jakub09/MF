{
  "$schema": "../hsm-messages.schema.json",
  "member": "MIGRATE",
  "description": "Mapowanie komunikatow z members/MIGRATE.txt",
  "messages": {
    "ARC0520I": {
      "description": "Primary Space Management - start",
      "pattern": "^PRIMARY SPACE MANAGEMENT (?<status>STARTING|RESTARTING)",
      "extract": {"status": "tag"},
      "constTags": {"function": "PSM"},
      "time": {"fallback": "next"}
    },
    "ARC0521I": {
      "description": "Primary Space Management - koniec",
      "pattern": "^PRIMARY SPACE MANAGEMENT (?<status>ENDED SUCCESSFULLY|COMPLETED, ENDING TIME REACHED|ENDED PRIOR TO COMPLETION)(?:,\\s*(?<end_reason>.+))?",
      "extract": {
        "status": {"to": "tag", "map": {"COMPLETED, ENDING TIME REACHED": "ENDING TIME REACHED"}},
        "end_reason": "tag"
      },
      "constTags": {"function": "PSM"}
    },
    "ARC0517I": {
      "description": "Secondary Space Management - start",
      "pattern": "^SECONDARY SPACE MANAGEMENT (?<status>STARTING|RESTARTING)",
      "extract": {"status": "tag"},
      "constTags": {"function": "SSM"},
      "time": {"fallback": "next"}
    },
    "ARC0518I": {
      "description": "Secondary Space Management - koniec",
      "pattern": "^SECONDARY SPACE MANAGEMENT (?<status>ENDED SUCCESSFULLY|COMPLETED, ENDING TIME REACHED|ENDED PRIOR TO COMPLETION)(?:,\\s*(?<end_reason>.+))?",
      "extract": {
        "status": {"to": "tag", "map": {"COMPLETED, ENDING TIME REACHED": "ENDING TIME REACHED"}},
        "end_reason": "tag"
      },
      "constTags": {"function": "SSM"}
    }
  }
}
