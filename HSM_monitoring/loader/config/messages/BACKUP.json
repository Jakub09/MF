{
  "$schema": "../hsm-messages.schema.json",
  "member": "BACKUP",
  "description": "Mapowanie komunikatow z members/BACKUP.txt",
  "messages": {
    "ARC0720I": {
      "description": "Automatic backup - start",
      "pattern": "^AUTOMATIC BACKUP (?<status>STARTING|RESTARTING)",
      "extract": {"status": "tag"},
      "constTags": {"function": "AUTOBACKUP"},
      "time": {"fallback": "next"}
    },
    "ARC0721I": {
      "description": "Automatic backup - koniec",
      "pattern": "^AUTOMATIC BACKUP (?<status>ENDING)",
      "extract": {"status": "tag"},
      "constTags": {"function": "AUTOBACKUP"}
    },
    "ARC0570I": {
      "description": "Funkcja na wolumenie przerwana (MIGLOG, BAKLOG, DMPLOG)",
      "pattern": "^(?<function>.+?) FOR (?<scope>.+?) VOLUME\\(S\\) TERMINATED,\\s*RC=\\s*(?<rc>\\d+),\\s*REASON=\\s*(?<reason>\\d+)",
      "extract": {"function": "tag", "scope": "tag", "rc": "int", "reason": "int"}
    }
  }
}
