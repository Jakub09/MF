{
  "$schema": "../hsm-messages.schema.json",
  "member": "DUMP",
  "description": "Mapowanie komunikatow z members/DUMP.txt",
  "messages": {
    "ARC0620I": {
      "description": "Automatic dump - start",
      "pattern": "^AUTOMATIC DUMP (?<status>STARTING|RESTARTING)",
      "extract": {"status": "tag"},
      "constTags": {"function": "AUTODUMP"},
      "time": {"fallback": "next"}
    },
    "ARC0621I": {
      "description": "Automatic dump - koniec",
      "pattern": "^AUTOMATIC DUMP (?<status>ENDING)",
      "extract": {"status": "tag"},
      "constTags": {"function": "AUTODUMP"}
    },
    "ARC0625I": {
      "description": "Automatic dump - przerwany",
      "pattern": "^AUTOMATIC DUMP TERMINATED PRIOR TO COMPLETION,\\s*(?<term_reason>.+)",
      "extract": {"term_reason": "tag"},
      "constTags": {"function": "AUTODUMP", "status": "TERMINATED"}
    }
  }
}
