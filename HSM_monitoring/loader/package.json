{
  "name": "hsm-loader",
  "version": "0.1.0",
  "private": true,
  "description": "Mapowanie komunikatow DFSMShsm ARC* (Activity Log po ekstrakcji DFSORT) na punkty InfluxDB 1.x i rekordy SQLite",
  "bin": {
    "hsm-load": "dist/src/cli.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "cli": "tsx src/cli.ts",
    "schema": "tsx tools/generate-schema.ts"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
