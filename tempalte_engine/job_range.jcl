//TMPLRNG  JOB ,'TMPLGEN RANGE',CLASS=A,MSGCLASS=H,NOTIFY=&SYSUID
//*--------------------------------------------------------------------
//* TMPLGEN - zwiniecie listy volumenow w zakresy i wygenerowanie
//*           jednej linii komendy na kazdy zakres (MODE COMMAND)
//*--------------------------------------------------------------------
//RUN      EXEC PGM=IRXJCL,PARM='TMPLGEN'
//SYSEXEC  DD DISP=SHR,DSN=YOUR.USERID.REXX.EXEC
//SYSTSIN  DD DUMMY
//SYSTSPRT DD SYSOUT=*
//GENOUT   DD SYSOUT=*
//LISTIN   DD *
VOLSR0 1000
VOLSR1 1001
VOLSR2 1002
VOLSR3 1003
VOLSR4 1004
VOLSR5 1005
VOLSR6 1006
VOLSR7 1007
VOLSR8 1008
VOLSR9 1009
VOLSRA 100A
VOLSRB 100B
VOLSRC 100C
VOLSRD 100D
VOLSRE 100E
VOLSRF 100F
/*
//VARDEF   DD *
VOLSR UNIT
/*
//TMPLTIN  DD *
 SCDS(MYCDS) VOL(SMS) PREF({RNGPREF}) FROM({RNGSTART}) TO({RNGEND}) -
  SUF({RNGSUFF}) TYPE({RNGTYPE}) SG(PRIMARY) STATUS(ENABLE)
/*
//CMDIN    DD *
  RANGE(LISTIN, VAR(VOLSR) PREFIX('VOLSR') TYPE(X) MAX(100) NOGAPS)
  SUBSTITUTE(TMPLTIN) MODE(COMMAND)
/*
