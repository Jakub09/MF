//TGTST4   JOB ,'TMPLGEN TEST IT4',CLASS=A,MSGCLASS=H,NOTIFY=&SYSUID
//*====================================================================
//* TMPLGEN - TESTY INTEGRACYJNE ITERACJI 4 (generowanie: COMMAND,
//*           STEP, JOB) - wynik GENOUT porownywany z DD EXPECT
//*
//* Testuje exec &TGEXEC (domyslnie TMPLGEN z BUILD).
//* Kazdy krok: PARM='TGRUN exec oczekiwany-RC'. Gdy jest DD EXPECT,
//* TGRUN porownuje GENOUT (dataset tymczasowy) z EXPECT linia po
//* linii i wypisuje roznice. EXPECT w formacie './ ADD NAME=member'
//* (T06, T07) = porownanie memberow PDS wskazanego przez GENOUT.
//*   RC kroku 0 = test zaliczony, 12 = nieudany (SYSTSPRT, TGRUN-E)
//*====================================================================
//         SET TSTLIB=YOUR.USERID.REXX.TEST
//         SET EXECLIB=YOUR.USERID.REXX.EXEC
//         SET TGEXEC=TMPLGEN
//*        testowy PDS (T06-T08) - kasowany i zakladany przez ten job
//         SET TSTPDS=YOUR.USERID.TMPLGEN.TESTPDS
//*
//*-- T01: RANGE + COMMAND (przyklad example2) -> RC=0
//T01      EXEC PGM=IRXJCL,PARM='TGRUN &TGEXEC 0'
//SYSEXEC  DD DISP=SHR,DSN=&EXECLIB
//         DD DISP=SHR,DSN=&TSTLIB
//SYSTSIN  DD DUMMY
//SYSTSPRT DD SYSOUT=*
//GENOUT   DD DSN=&&G01,DISP=(NEW,DELETE),UNIT=SYSDA,
//            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=80,DSORG=PS
//LISTIN   DD *
VOLSR0 1000
VOLSR1 1001
VOLSR2 1002
VOLSR8 1008
VOLSR9 1009
VOLSRA 100A
/*
//VARDEF   DD *
VOLSR UNIT
/*
//TMPLTIN  DD *
 SCDS(MYCDS) VOL(SMS) PREF({RNGPREF}) FROM({RNGSTART}) TO({RNGEND}) -
  SUF({RNGSUFF}) TYPE({RNGTYPE}) SG(PRIMARY) STATUS(ENABLE)
/*
//CMDIN    DD *
  RANGE(LISTIN, VAR(VOLSR) PREFIX('VOLSR') TYPE(X) MAX(100) NOGAPS)
  SUBSTITUTE(TMPLTIN, MODE(COMMAND))
/*
//EXPECT   DD *
 SCDS(MYCDS) VOL(SMS) PREF(VOLSR) FROM(0) TO(2) -
  SUF() TYPE(X) SG(PRIMARY) STATUS(ENABLE)
 SCDS(MYCDS) VOL(SMS) PREF(VOLSR) FROM(8) TO(A) -
  SUF() TYPE(X) SG(PRIMARY) STATUS(ENABLE)
/*
//*
//*-- T02: STEP + karta JOB + MAXSTEPS(2) -> 2 joby, RC=0
//T02      EXEC PGM=IRXJCL,PARM='TGRUN &TGEXEC 0'
//SYSEXEC  DD DISP=SHR,DSN=&EXECLIB
//         DD DISP=SHR,DSN=&TSTLIB
//SYSTSIN  DD DUMMY
//SYSTSPRT DD SYSOUT=*
//GENOUT   DD DSN=&&G02,DISP=(NEW,DELETE),UNIT=SYSDA,
//            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=80,DSORG=PS
//LISTIN   DD *
VOLSR0 1000
VOLSR1 1001
VOLSR2 1002
/*
//VARDEF   DD *
VOLSR UNIT
/*
//JOBCARD  DD DATA,DLM=@@
//DSSJOB{_JOBSEQ} JOB ,'DSS',CLASS=A,MSGCLASS=H
@@
//TMPLTIN  DD DATA,DLM=@@
//DUMP1    EXEC PGM=ADRDSSU
//INDD     DD  DISP=SHR,UNIT=3390,VOL=SER={VOLSR}
//SYSIN    DD  *
  DUMP FULL INDD(INDD) OUTDD(OUTDD)
/*
@@
//CMDIN    DD *
  STEP HEADER(JOBCARD) MAXSTEPS(2)
/*
//EXPECT   DD DATA,DLM=@@
//DSSJOB1 JOB ,'DSS',CLASS=A,MSGCLASS=H
//DUMP001  EXEC PGM=ADRDSSU
//INDD     DD  DISP=SHR,UNIT=3390,VOL=SER=VOLSR0
//SYSIN    DD  *
  DUMP FULL INDD(INDD) OUTDD(OUTDD)
/*
//DUMP002  EXEC PGM=ADRDSSU
//INDD     DD  DISP=SHR,UNIT=3390,VOL=SER=VOLSR1
//SYSIN    DD  *
  DUMP FULL INDD(INDD) OUTDD(OUTDD)
/*
//DSSJOB2 JOB ,'DSS',CLASS=A,MSGCLASS=H
//DUMP003  EXEC PGM=ADRDSSU
//INDD     DD  DISP=SHR,UNIT=3390,VOL=SER=VOLSR2
//SYSIN    DD  *
  DUMP FULL INDD(INDD) OUTDD(OUTDD)
/*
@@
//*
//*-- T03: JOB - osobny job na rekord, zmienna globalna SET -> RC=0
//T03      EXEC PGM=IRXJCL,PARM='TGRUN &TGEXEC 0'
//SYSEXEC  DD DISP=SHR,DSN=&EXECLIB
//         DD DISP=SHR,DSN=&TSTLIB
//SYSTSIN  DD DUMMY
//SYSTSPRT DD SYSOUT=*
//GENOUT   DD DSN=&&G03,DISP=(NEW,DELETE),UNIT=SYSDA,
//            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=80,DSORG=PS
//LISTIN   DD *
VOLSR0 1000
VOLSR1 1001
/*
//VARDEF   DD *
VOLSR UNIT
/*
//TMPLTIN  DD DATA,DLM=@@
//{VOLSR}  JOB ,'DSS {UNIT}',CLASS=A,MSGCLASS=H
//DUMP     EXEC PGM=ADRDSSU
//OUTDD    DD  DSN={HLQ}.{VOLSR},DISP=(NEW,CATLG)
@@
//CMDIN    DD *
  SET HLQ('BACKUP.DSS')
  JOB
/*
//EXPECT   DD DATA,DLM=@@
//VOLSR0  JOB ,'DSS 1000',CLASS=A,MSGCLASS=H
//DUMP     EXEC PGM=ADRDSSU
//OUTDD    DD  DSN=BACKUP.DSS.VOLSR0,DISP=(NEW,CATLG)
//VOLSR1  JOB ,'DSS 1001',CLASS=A,MSGCLASS=H
//DUMP     EXEC PGM=ADRDSSU
//OUTDD    DD  DSN=BACKUP.DSS.VOLSR1,DISP=(NEW,CATLG)
@@
//*
//*-- T04: COMMAND z HEADER/TRAILER, MAXCMD(2) -> 2 bloki, RC=0
//T04      EXEC PGM=IRXJCL,PARM='TGRUN &TGEXEC 0'
//SYSEXEC  DD DISP=SHR,DSN=&EXECLIB
//         DD DISP=SHR,DSN=&TSTLIB
//SYSTSIN  DD DUMMY
//SYSTSPRT DD SYSOUT=*
//GENOUT   DD DSN=&&G04,DISP=(NEW,DELETE),UNIT=SYSDA,
//            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=80,DSORG=PS
//LISTIN   DD *
VOLSR0 1000
VOLSR1 1001
VOLSR2 1002
/*
//VARDEF   DD *
VOLSR UNIT
/*
//HDR      DD DATA,DLM=@@
//IDC{_JOBSEQ:2} EXEC PGM=IDCAMS
//SYSIN    DD *
@@
//TRL      DD DATA,DLM=@@
/*
@@
//TMPLTIN  DD *
  DELETE (SYS1.{VOLSR}.DATA)
/*
//CMDIN    DD *
  COMMAND HEADER(HDR) TRAILER(TRL) MAXCMD(2)
/*
//EXPECT   DD DATA,DLM=@@
//IDC01 EXEC PGM=IDCAMS
//SYSIN    DD *
  DELETE (SYS1.VOLSR0.DATA)
  DELETE (SYS1.VOLSR1.DATA)
/*
//IDC02 EXEC PGM=IDCAMS
//SYSIN    DD *
  DELETE (SYS1.VOLSR2.DATA)
/*
@@
//*
//*-- T05: nieznana zmienna -> RC=8 i GENOUT NIE jest zapisany
//T05      EXEC PGM=IRXJCL,PARM='TGRUN &TGEXEC 8'
//SYSEXEC  DD DISP=SHR,DSN=&EXECLIB
//         DD DISP=SHR,DSN=&TSTLIB
//SYSTSIN  DD DUMMY
//SYSTSPRT DD SYSOUT=*
//GENOUT   DD SYSOUT=*
//LISTIN   DD *
VOLSR0 1000
/*
//VARDEF   DD *
VOLSR UNIT
/*
//TMPLTIN  DD *
 DELETE {VOLSR}.{NOPE}
/*
//CMDIN    DD *
  COMMAND
/*
//*
//*-- T06..T08: zapis do PDS. Testowy PDS musi byc skatalogowany
//*   (TMPLGEN alokuje membery po nazwie) - kasowany i zakladany tu.
//T06DEL   EXEC PGM=IEFBR14
//PDS      DD DSN=&TSTPDS,DISP=(MOD,DELETE),UNIT=SYSDA,SPACE=(TRK,0)
//T06NEW   EXEC PGM=IEFBR14
//PDS      DD DSN=&TSTPDS,DISP=(NEW,CATLG),UNIT=SYSDA,
//            SPACE=(TRK,(5,5,10)),DSORG=PO,RECFM=FB,LRECL=80
//*
//*-- T06: GENOUT = PDS (DSORG=PO) - domyslnie 1 job = 1 member, RC=0
//T06      EXEC PGM=IRXJCL,PARM='TGRUN &TGEXEC 0'
//SYSEXEC  DD DISP=SHR,DSN=&EXECLIB
//         DD DISP=SHR,DSN=&TSTLIB
//SYSTSIN  DD DUMMY
//SYSTSPRT DD SYSOUT=*
//GENOUT   DD DISP=SHR,DSN=&TSTPDS,DSORG=PO
//LISTIN   DD *
VOLSR0 1000
VOLSR1 1001
/*
//VARDEF   DD *
VOLSR UNIT
/*
//TMPLTIN  DD DATA,DLM=@@
//{VOLSR}  JOB ,'DSS {UNIT}',CLASS=A,MSGCLASS=H
//DUMP     EXEC PGM=ADRDSSU
@@
//CMDIN    DD *
  JOB
/*
//EXPECT   DD DATA,DLM=@@
./ ADD NAME=VOLSR0
//VOLSR0  JOB ,'DSS 1000',CLASS=A,MSGCLASS=H
//DUMP     EXEC PGM=ADRDSSU
./ ADD NAME=VOLSR1
//VOLSR1  JOB ,'DSS 1001',CLASS=A,MSGCLASS=H
//DUMP     EXEC PGM=ADRDSSU
@@
//*
//*-- T07: OUTPUT MEMBER(ALLJOBS) - wszystko do jednego membra, RC=0
//T07      EXEC PGM=IRXJCL,PARM='TGRUN &TGEXEC 0'
//SYSEXEC  DD DISP=SHR,DSN=&EXECLIB
//         DD DISP=SHR,DSN=&TSTLIB
//SYSTSIN  DD DUMMY
//SYSTSPRT DD SYSOUT=*
//GENOUT   DD DISP=SHR,DSN=&TSTPDS,DSORG=PO
//LISTIN   DD *
VOLSR0 1000
VOLSR1 1001
/*
//VARDEF   DD *
VOLSR UNIT
/*
//TMPLTIN  DD DATA,DLM=@@
//{VOLSR}  JOB ,'DSS {UNIT}',CLASS=A,MSGCLASS=H
//DUMP     EXEC PGM=ADRDSSU
@@
//CMDIN    DD *
  OUTPUT(GENOUT) MEMBER(ALLJOBS)
  JOB
/*
//EXPECT   DD DATA,DLM=@@
./ ADD NAME=ALLJOBS
//VOLSR0  JOB ,'DSS 1000',CLASS=A,MSGCLASS=H
//DUMP     EXEC PGM=ADRDSSU
//VOLSR1  JOB ,'DSS 1001',CLASS=A,MSGCLASS=H
//DUMP     EXEC PGM=ADRDSSU
@@
//*
//*-- T08: ta sama nazwa joba dla 2 rekordow -> duplikat membra,
//*        nic nie jest zapisane, RC=8
//T08      EXEC PGM=IRXJCL,PARM='TGRUN &TGEXEC 8'
//SYSEXEC  DD DISP=SHR,DSN=&EXECLIB
//         DD DISP=SHR,DSN=&TSTLIB
//SYSTSIN  DD DUMMY
//SYSTSPRT DD SYSOUT=*
//GENOUT   DD DISP=SHR,DSN=&TSTPDS,DSORG=PO
//LISTIN   DD *
VOLSR0 1000
VOLSR1 1001
/*
//VARDEF   DD *
VOLSR UNIT
/*
//TMPLTIN  DD DATA,DLM=@@
//DUPJOB   JOB ,'DSS {UNIT}',CLASS=A,MSGCLASS=H
//DUMP     EXEC PGM=ADRDSSU,PARM='{VOLSR}'
@@
//CMDIN    DD *
  JOB
/*
//*
//*-- sprzatanie: usuniecie testowego PDS
//T08DEL   EXEC PGM=IEFBR14
//PDS      DD DSN=&TSTPDS,DISP=(OLD,DELETE)
