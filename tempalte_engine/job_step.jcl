//TMPLSTEP JOB ,'TMPLGEN STEP',CLASS=A,MSGCLASS=H,NOTIFY=&SYSUID
//*--------------------------------------------------------------------
//* TMPLGEN - tryb STEP: jeden krok ADRDSSU na kazdy rekord LISTIN,
//*           karta JOB z DD JOBCARD. Wynik do GENOUT.
//*           Zeby od razu zasubmitowac: GENOUT DD SYSOUT=(A,INTRDR)
//*--------------------------------------------------------------------
//RUN      EXEC PGM=IRXJCL,PARM='TMPLGEN'
//SYSEXEC  DD DISP=SHR,DSN=YOUR.USERID.REXX.EXEC
//SYSTSIN  DD DUMMY
//SYSTSPRT DD SYSOUT=*
//GENOUT   DD SYSOUT=*
//LISTIN   DD *
VOLSR0 1000
VOLSR1 1001
VOLSR2 1002
VOLSR3 1003
VOLSR4 1004
VOLSR5 1005
VOLSR6 1006
VOLSR7 1007
VOLSR8 1008
VOLSR9 1009
VOLSRA 100A
VOLSRB 100B
VOLSRC 100C
VOLSRD 100D
VOLSRE 100E
VOLSRF 100F
/*
//VARDEF   DD *
VOLSR UNIT
/*
//JOBCARD  DD DATA,DLM=@@
//DSSCOPY{_JOBSEQ} JOB ,'DSS COPY',CLASS=A,MSGCLASS=H,NOTIFY=&SYSUID
@@
//TMPLTIN  DD DATA,DLM=@@
//STEP1    EXEC PGM=ADRDSSU
//SYSPRINT DD  SYSOUT=*
//INDD     DD  DISP=SHR,UNIT=3390,VOL=SER={VOLSR}
//SYSIN    DD  *
  COPY DATASET(INCLUDE(YOUR.HLQ.**)) -
       LOGINDD(INDD) OUTDD(OUTDD) -
       DELETE RECATALOG(*)
/*
@@
//CMDIN    DD *
* jeden krok na rekord, karta JOB z DD JOBCARD
  STEP HEADER(JOBCARD)
/*
