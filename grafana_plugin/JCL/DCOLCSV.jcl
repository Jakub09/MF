//DCOLCSV  JOB (ACCT),'DCOLLECT TO CSV',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*********************************************************************
//* DCOLLECT -> FILTR (V/VL/C) -> JOINKEYS PO VOLSER -> CSV
//*
//*  STEP DELOLD  : USUNIECIE WYNIKOW Z POPRZEDNIEGO PRZEBIEGU
//*  STEP DCOL    : IDCAMS DCOLLECT WSZYSTKICH VOLUMENOW, NODATAINFO
//*                 + SMSDATA  (REKORDY VL)
//*                 + CAPPLANDATA (REKORDY C = CAPACITY PLANNING)
//*  STEP FILTR   : ICETOOL - ZOSTAWIA TYLKO 'V ', 'VL', 'C '
//*                 (VB -> FB, RDW ZACHOWANY, WIEC POZYCJA = OFFSET+1)
//*  STEP JOIN1   : JOINKEYS V  + VL  (LEFT OUTER, KLUCZ = VOLSER)
//*  STEP JOIN2   : JOINKEYS J1 + C   (LEFT OUTER, KLUCZ = VOLSER)
//*  STEP TOCSV   : MAPOWANIE WSZYSTKICH POL DO CSV (SEPARATOR ';')
//*
//* UKLAD REKORDU PO JOINACH (LRECL 802):
//*    1- 300  REKORD V   (Z RDW)
//*  301- 600  REKORD VL  (Z RDW)
//*  601       ? Z JOIN1  (B=JEST VL, 1=BRAK VL)
//*  602- 801  REKORD C   (Z RDW)
//*  802       ? Z JOIN2  (B=JEST C,  1=BRAK C)
//*
//* UWAGA: OFFSETY POL W SYMNAMES (STEP TOCSV) SPRAWDZ Z MAKREM
//*        IDCDOUT W SYS1.MACLIB DLA SWOJEGO POZIOMU Z/OS.
//*********************************************************************
//         SET HLQ=MYHLQ
//         SET MCDS=HSM.MCDS
//         SET BCDS=HSM.BCDS
//*
//DELOLD   EXEC PGM=IEFBR14
//DD1      DD DSN=&HLQ..DCOLLECT.RAW,DISP=(MOD,DELETE),
//            SPACE=(TRK,(1,1)),UNIT=SYSDA
//DD2      DD DSN=&HLQ..DCOLLECT.CSV,DISP=(MOD,DELETE),
//            SPACE=(TRK,(1,1)),UNIT=SYSDA
//*
//*-------------------------------------------------------------------
//* 1. DCOLLECT - WSZYSTKIE VOLUMENY ONLINE, BEZ INFO O DATASETACH
//*    MCDS/BCDS SA WYMAGANE PRZEZ CAPPLANDATA (DFSMSHSM)
//*-------------------------------------------------------------------
//DCOL     EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//DCOUT    DD DSN=&HLQ..DCOLLECT.RAW,DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(20,20),RLSE),UNIT=SYSDA,
//            DCB=(RECFM=VB,LRECL=1020,BLKSIZE=0)
//MCDS     DD DSN=&MCDS,DISP=SHR
//BCDS     DD DSN=&BCDS,DISP=SHR
//SYSIN    DD *
  DCOLLECT OUTFILE(DCOUT) -
           VOLUMES(*)     -
           NODATAINFO     -
           SMSDATA(ACTIVE) -
           CAPPLANDATA
/*
//*-------------------------------------------------------------------
//* 2. ICETOOL - FILTR TYPOW REKORDOW 'V ', 'VL', 'C '
//*    DCOLLECT CZESTO KONCZY SIE RC=4/8 (VOLUMENY NIEDOSTEPNE),
//*    STAD COND=(8,LT) - DALSZE KROKI IDA PRZY RC<=8
//*-------------------------------------------------------------------
//FILTR    EXEC PGM=ICETOOL,COND=(8,LT)
//TOOLMSG  DD SYSOUT=*
//DFSMSG   DD SYSOUT=*
//DCOLIN   DD DSN=&HLQ..DCOLLECT.RAW,DISP=SHR
//OUTV     DD DSN=&&DCV,DISP=(NEW,PASS),UNIT=SYSDA,
//            SPACE=(CYL,(5,5),RLSE),RECFM=FB,LRECL=300
//OUTVL    DD DSN=&&DCVL,DISP=(NEW,PASS),UNIT=SYSDA,
//            SPACE=(CYL,(5,5),RLSE),RECFM=FB,LRECL=300
//OUTC     DD DSN=&&DCC,DISP=(NEW,PASS),UNIT=SYSDA,
//            SPACE=(CYL,(5,5),RLSE),RECFM=FB,LRECL=200
//TOOLIN   DD *
  COPY  FROM(DCOLIN) USING(FLT1)
  COUNT FROM(OUTV)  EMPTY RC12
  COUNT FROM(OUTVL)
  COUNT FROM(OUTC)
/*
//FLT1CNTL DD *
  OUTFIL FNAMES=OUTV,INCLUDE=(5,2,CH,EQ,C'V '),
         VTOF,VLFILL=X'00',BUILD=(1,300)
  OUTFIL FNAMES=OUTVL,INCLUDE=(5,2,CH,EQ,C'VL'),
         VTOF,VLFILL=X'00',BUILD=(1,300)
  OUTFIL FNAMES=OUTC,INCLUDE=(5,2,CH,EQ,C'C '),
         VTOF,VLFILL=X'00',BUILD=(1,200)
/*
//*-------------------------------------------------------------------
//* 3A. JOINKEYS V + VL PO VOLSER (POZ. 25, DL. 6)
//*     WSZYSTKIE V ZOSTAJA, VL DOKLEJANE JESLI ISTNIEJE (SMS)
//*-------------------------------------------------------------------
//JOIN1    EXEC PGM=SORT,COND=(8,LT)
//SYSOUT   DD SYSOUT=*
//SORTJNF1 DD DSN=&&DCV,DISP=(OLD,DELETE)
//SORTJNF2 DD DSN=&&DCVL,DISP=(OLD,DELETE)
//SORTOUT  DD DSN=&&J1,DISP=(NEW,PASS),UNIT=SYSDA,
//            SPACE=(CYL,(10,10),RLSE),RECFM=FB,LRECL=601
//SYSIN    DD *
  JOINKEYS FILE=F1,FIELDS=(25,6,A)
  JOINKEYS FILE=F2,FIELDS=(25,6,A)
  JOIN UNPAIRED,F1
  REFORMAT FIELDS=(F1:1,300,F2:1,300,?),FILL=X'00'
  OPTION COPY
/*
//*-------------------------------------------------------------------
//* 3B. JOINKEYS (V+VL) + C PO VOLSER
//*     C TO HISTORIA DZIENNA Z HSM -> 1 VOLUMEN : N REKORDOW C
//*-------------------------------------------------------------------
//JOIN2    EXEC PGM=SORT,COND=(8,LT)
//SYSOUT   DD SYSOUT=*
//SORTJNF1 DD DSN=&&J1,DISP=(OLD,DELETE)
//SORTJNF2 DD DSN=&&DCC,DISP=(OLD,DELETE)
//SORTOUT  DD DSN=&&J2,DISP=(NEW,PASS),UNIT=SYSDA,
//            SPACE=(CYL,(10,10),RLSE),RECFM=FB,LRECL=802
//SYSIN    DD *
  JOINKEYS FILE=F1,FIELDS=(25,6,A)
  JOINKEYS FILE=F2,FIELDS=(25,6,A)
  JOIN UNPAIRED,F1
  REFORMAT FIELDS=(F1:1,601,F2:1,200,?),FILL=X'00'
  OPTION COPY
/*
//*-------------------------------------------------------------------
//* 4. CSV. POLA POWTARZAJACE SIE POMINIETE:
//*    - NAGLOWEK (RDW, TYP, WERSJA, SYSID, CZAS) TYLKO Z V
//*    - VOLSER TYLKO Z V (VL_VOLSER, C_VOLSER = KLUCZ JOINA)
//*    - STORAGE GROUP TYLKO Z V (VL_SGNAME TO SAMO)
//*    - POJEMNOSC TYLKO Z V (C_TOTAL = DCVVLCAP)
//*    DCVFLAG1 ROZBITY NA KOLUMNY Y/N (BEZ DODATKOWEGO HEX)
//*
//*    OBSZAR ROBOCZY OUTREC:
//*    1001-1300 POLA V, 1301-1400 FLAGI V, 1401-1800 POLA VL,
//*    1801-2000 POLA C, 2001-2014 DATY JULIANSKIE (CCYYDDD)
//*    NA KONIEC SQZ USUWA SPACJE -> CZYSTY CSV
//*
//*    DCVFLAG1: 80 IXVTOC EXISTS, 40 IXVTOC ENABLED, 20 PRIVATE,
//*              10 PUBLIC, 08 STORAGE, 04 SHARED DASD
//*    BRAK VL -> VL_FOUND=N + 19 PUSTYCH POL
//*    STATUS VL PER SYSTEM (1-8), KOLEJNOSC JAK W BASE CONFIG SMS:
//*      SMS: 1 ENABLE 2 QUIALL 3 QUINEW 4 DISALL 5 DISNEW
//*      MVS: 1 ONLINE 2 OFFLINE 3 PEND_OFF 4 BOXED 5 NOT_READY
//*      0 = SYSTEM NIEZDEFINIOWANY -> PUSTE POLE
//*      INNA WARTOSC -> UNKNWN / UNKNOWN
//*    BRAK C  -> CP_FOUND=N + 8 PUSTYCH POL
//*-------------------------------------------------------------------
//TOCSV    EXEC PGM=SORT,COND=(8,LT)
//SYSOUT   DD SYSOUT=*
//SYMNOUT  DD SYSOUT=*
//SORTIN   DD DSN=&&J2,DISP=(OLD,DELETE)
//CSV      DD DSN=&HLQ..DCOLLECT.CSV,DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(5,5),RLSE),UNIT=SYSDA,
//            RECFM=VB,LRECL=1004
//SYMNAMES DD *
* --- NAGLOWEK + REKORD V (DCVOLUME), POZYCJA = OFFSET + 1 ---------
V_VERS,7,2,BI
V_SYSID,9,4,CH
V_TIME,13,4,BI
V_DATE,17,4,PD
V_VOLSER,25,6,CH
V_FLAG1,31,1
V_FLAG2,32,1
V_PERCT,33,1,BI
V_FRESP,37,4,BI
V_ALLOC,41,4,BI
V_VLCAP,45,4,BI
V_FRAGI,49,4,BI
V_LGEXT,53,4,BI
V_FREXT,57,4,BI
V_FDSCB,61,4,BI
V_FVIRS,65,4,BI
V_DVTYP,69,8,CH
V_DVNUM,77,2
V_SGNAME,81,8,CH
* EAV - PRZESTRZEN CYLINDER-MANAGED
V_FRESC,89,4,BI
V_ALLCC,93,4,BI
V_VLCPC,97,4,BI
V_FRAGC,101,4,BI
V_LGEXC,105,4,BI
V_FREXC,109,4,BI
J1_IND,601,1,CH
* --- REKORD VL, POZYCJA = OFFSET + 301 ---------------------------
VL_VOLSER,325,6,CH
VL_SGNAME,335,30,CH
VL_USER,365,8,CH
VL_DATE,373,10,CH
VL_TIME,383,8,CH
* STATUS PER SYSTEM 1-8: 2 BAJTY = STATUS SMS + STATUS MVS
VL_S1SMS,391,1
VL_S1MVS,392,1
VL_S2SMS,393,1
VL_S2MVS,394,1
VL_S3SMS,395,1
VL_S3MVS,396,1
VL_S4SMS,397,1
VL_S4MVS,398,1
VL_S5SMS,399,1
VL_S5MVS,400,1
VL_S6SMS,401,1
VL_S6MVS,402,1
VL_S7SMS,403,1
VL_S7MVS,404,1
VL_S8SMS,405,1
VL_S8MVS,406,1
* --- REKORD C, POZYCJA = OFFSET + 602 ----------------------------
C_VOLSER,626,6,CH
C_FLAGS,632,1
C_COLDT,634,4,PD
C_COLDTB,634,4,BI
C_TOTAL,638,4,BI
C_TARGO,642,1,BI
C_TRIGO,643,1,BI
C_BEFOR,644,1,BI
C_AFTER,645,1,BI
C_NOMIG,646,1,BI
C_INTVM,647,1,BI
J2_IND,802,1,CH
/*
//SYSIN    DD *
  SORT FIELDS=(V_VOLSER,A,C_COLDTB,A)
  OUTREC IFTHEN=(WHEN=INIT,
          OVERLAY=(2001:V_DATE,ADD,+1900000,EDIT=(TTTTTTT))),
   IFTHEN=(WHEN=INIT,
          OVERLAY=(1001:V_VOLSER,
           C';',V_SYSID,
           C';',2001,7,Y4T,TOGREG=Y4T(-),
           C';',V_TIME,DIV,+360000,EDIT=(TT),
           C':',V_TIME,DIV,+6000,MOD,+60,EDIT=(TT),
           C':',V_TIME,DIV,+100,MOD,+60,EDIT=(TT),
           C';',V_VERS,EDIT=(IIIT),
           C';',V_DVTYP,
           C';',V_DVNUM,HEX,
           C';',V_SGNAME,
           C';',V_FLAG2,HEX,
           C';',V_PERCT,EDIT=(IIT),
           C';',V_FRESP,EDIT=(IIIIIIIIIT),
           C';',V_ALLOC,EDIT=(IIIIIIIIIT),
           C';',V_VLCAP,EDIT=(IIIIIIIIIT),
           C';',V_FRAGI,EDIT=(IIIIIIIIIT),
           C';',V_LGEXT,EDIT=(IIIIIIIIIT),
           C';',V_FREXT,EDIT=(IIIIIIIIIT),
           C';',V_FDSCB,EDIT=(IIIIIIIIIT),
           C';',V_FVIRS,EDIT=(IIIIIIIIIT),
           C';',V_FRESC,EDIT=(IIIIIIIIIT),
           C';',V_ALLCC,EDIT=(IIIIIIIIIT),
           C';',V_VLCPC,EDIT=(IIIIIIIIIT),
           C';',V_FRAGC,EDIT=(IIIIIIIIIT),
           C';',V_LGEXC,EDIT=(IIIIIIIIIT),
           C';',V_FREXC,EDIT=(IIIIIIIIIT),
           1301:C';N;N;N;N;N;N')),
   IFTHEN=(WHEN=(V_FLAG1,BO,X'80'),OVERLAY=(1302:C'Y'),HIT=NEXT),
   IFTHEN=(WHEN=(V_FLAG1,BO,X'40'),OVERLAY=(1304:C'Y'),HIT=NEXT),
   IFTHEN=(WHEN=(V_FLAG1,BO,X'20'),OVERLAY=(1306:C'Y'),HIT=NEXT),
   IFTHEN=(WHEN=(V_FLAG1,BO,X'10'),OVERLAY=(1308:C'Y'),HIT=NEXT),
   IFTHEN=(WHEN=(V_FLAG1,BO,X'08'),OVERLAY=(1310:C'Y'),HIT=NEXT),
   IFTHEN=(WHEN=(V_FLAG1,BO,X'04'),OVERLAY=(1312:C'Y'),HIT=NEXT),
   IFTHEN=(WHEN=(J1_IND,EQ,C'B'),
          OVERLAY=(1401:C';Y',
           C';',VL_USER,
           C';',VL_DATE,
           C';',VL_TIME,
           C';',VL_S1SMS,CHANGE=(6,X'00',C' ',
             X'01',C'ENABLE',X'02',C'QUIALL',X'03',C'QUINEW',
             X'04',C'DISALL',X'05',C'DISNEW'),NOMATCH=(C'UNKNWN'),
           C';',VL_S1MVS,CHANGE=(9,X'00',C' ',
             X'01',C'ONLINE',X'02',C'OFFLINE',X'03',C'PEND_OFF',
             X'04',C'BOXED',X'05',C'NOT_READY'),NOMATCH=(C'UNKNOWN'),
           C';',VL_S2SMS,CHANGE=(6,X'00',C' ',
             X'01',C'ENABLE',X'02',C'QUIALL',X'03',C'QUINEW',
             X'04',C'DISALL',X'05',C'DISNEW'),NOMATCH=(C'UNKNWN'),
           C';',VL_S2MVS,CHANGE=(9,X'00',C' ',
             X'01',C'ONLINE',X'02',C'OFFLINE',X'03',C'PEND_OFF',
             X'04',C'BOXED',X'05',C'NOT_READY'),NOMATCH=(C'UNKNOWN'),
           C';',VL_S3SMS,CHANGE=(6,X'00',C' ',
             X'01',C'ENABLE',X'02',C'QUIALL',X'03',C'QUINEW',
             X'04',C'DISALL',X'05',C'DISNEW'),NOMATCH=(C'UNKNWN'),
           C';',VL_S3MVS,CHANGE=(9,X'00',C' ',
             X'01',C'ONLINE',X'02',C'OFFLINE',X'03',C'PEND_OFF',
             X'04',C'BOXED',X'05',C'NOT_READY'),NOMATCH=(C'UNKNOWN'),
           C';',VL_S4SMS,CHANGE=(6,X'00',C' ',
             X'01',C'ENABLE',X'02',C'QUIALL',X'03',C'QUINEW',
             X'04',C'DISALL',X'05',C'DISNEW'),NOMATCH=(C'UNKNWN'),
           C';',VL_S4MVS,CHANGE=(9,X'00',C' ',
             X'01',C'ONLINE',X'02',C'OFFLINE',X'03',C'PEND_OFF',
             X'04',C'BOXED',X'05',C'NOT_READY'),NOMATCH=(C'UNKNOWN'),
           C';',VL_S5SMS,CHANGE=(6,X'00',C' ',
             X'01',C'ENABLE',X'02',C'QUIALL',X'03',C'QUINEW',
             X'04',C'DISALL',X'05',C'DISNEW'),NOMATCH=(C'UNKNWN'),
           C';',VL_S5MVS,CHANGE=(9,X'00',C' ',
             X'01',C'ONLINE',X'02',C'OFFLINE',X'03',C'PEND_OFF',
             X'04',C'BOXED',X'05',C'NOT_READY'),NOMATCH=(C'UNKNOWN'),
           C';',VL_S6SMS,CHANGE=(6,X'00',C' ',
             X'01',C'ENABLE',X'02',C'QUIALL',X'03',C'QUINEW',
             X'04',C'DISALL',X'05',C'DISNEW'),NOMATCH=(C'UNKNWN'),
           C';',VL_S6MVS,CHANGE=(9,X'00',C' ',
             X'01',C'ONLINE',X'02',C'OFFLINE',X'03',C'PEND_OFF',
             X'04',C'BOXED',X'05',C'NOT_READY'),NOMATCH=(C'UNKNOWN'),
           C';',VL_S7SMS,CHANGE=(6,X'00',C' ',
             X'01',C'ENABLE',X'02',C'QUIALL',X'03',C'QUINEW',
             X'04',C'DISALL',X'05',C'DISNEW'),NOMATCH=(C'UNKNWN'),
           C';',VL_S7MVS,CHANGE=(9,X'00',C' ',
             X'01',C'ONLINE',X'02',C'OFFLINE',X'03',C'PEND_OFF',
             X'04',C'BOXED',X'05',C'NOT_READY'),NOMATCH=(C'UNKNOWN'),
           C';',VL_S8SMS,CHANGE=(6,X'00',C' ',
             X'01',C'ENABLE',X'02',C'QUIALL',X'03',C'QUINEW',
             X'04',C'DISALL',X'05',C'DISNEW'),NOMATCH=(C'UNKNWN'),
           C';',VL_S8MVS,CHANGE=(9,X'00',C' ',
             X'01',C'ONLINE',X'02',C'OFFLINE',X'03',C'PEND_OFF',
             X'04',C'BOXED',X'05',C'NOT_READY'),
             NOMATCH=(C'UNKNOWN')),HIT=NEXT),
   IFTHEN=(WHEN=(J1_IND,EQ,C'1'),
          OVERLAY=(1401:C';N',19C';'),HIT=NEXT),
   IFTHEN=(WHEN=(J2_IND,EQ,C'B'),
          OVERLAY=(2008:C_COLDT,ADD,+1900000,EDIT=(TTTTTTT)),
          HIT=NEXT),
   IFTHEN=(WHEN=(J2_IND,EQ,C'B'),
          OVERLAY=(1801:C';Y',
           C';',C_FLAGS,HEX,
           C';',2008,7,Y4T,TOGREG=Y4T(-),
           C';',C_TARGO,EDIT=(IIT),
           C';',C_TRIGO,EDIT=(IIT),
           C';',C_BEFOR,EDIT=(IIT),
           C';',C_AFTER,EDIT=(IIT),
           C';',C_NOMIG,EDIT=(IIT),
           C';',C_INTVM,EDIT=(IIT)),HIT=NEXT),
   IFTHEN=(WHEN=(J2_IND,EQ,C'1'),
          OVERLAY=(1801:C';N',8C';'))
  OUTFIL FNAMES=CSV,REMOVECC,FTOV,VLTRIM=C' ',
   HEADER1=(C'VOLSER;SYSID;DCOL_DATE;DCOL_TIME;REC_VERSION;',
            C'DEVTYPE;DEVNUM;STORGRP;V_FLAG2_HEX;PCT_FREE;',
            C'FREE_KB;ALLOC_KB;CAPACITY_KB;FRAG_INDEX;',
            C'LARGEST_FREE_EXT_KB;FREE_EXTENTS;FREE_DSCBS;',
            C'FREE_VIRS;CYLMG_FREE_KB;CYLMG_ALLOC_KB;',
            C'CYLMG_CAPACITY_KB;CYLMG_FRAG_INDEX;',
            C'CYLMG_LARGEST_FREE_KB;CYLMG_FREE_EXTENTS;',
            C'IXVTOC_EXISTS;IXVTOC_ENABLED;USE_PRIVATE;',
            C'USE_PUBLIC;USE_STORAGE;SHARED_DASD;',
            C'VL_FOUND;VL_UPD_USER;VL_UPD_DATE;VL_UPD_TIME;',
            C'SYS1_SMS;SYS1_MVS;SYS2_SMS;SYS2_MVS;',
            C'SYS3_SMS;SYS3_MVS;SYS4_SMS;SYS4_MVS;',
            C'SYS5_SMS;SYS5_MVS;SYS6_SMS;SYS6_MVS;',
            C'SYS7_SMS;SYS7_MVS;SYS8_SMS;SYS8_MVS;',
            C'CP_FOUND;CP_FLAGS_HEX;CP_DATE;CP_TARGET_OCC_PCT;',
            C'CP_TRIGGER_OCC_PCT;CP_OCC_BEFORE_PCT;',
            C'CP_OCC_AFTER_PCT;CP_NOT_MIGRATED_PCT;',
            C'CP_INTERVAL_MIGR'),
   BUILD=(1001,1000,SQZ=(SHIFT=LEFT))
/*
