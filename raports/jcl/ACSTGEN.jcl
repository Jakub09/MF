//ACSTGEN JOB (ACCT),'ACS TEST GEN',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//NQPROC   JCLLIB ORDER=(SYS1.SACBCNTL)
//*-------------------------------------------------------------------
//* TESTY ACS 3/5: TESTY NAVIQUEST Z REPREZENTANTOW + WYNIKI BAZOWE
//*
//* WEJSCIE : REPDCOL Z JOBA ACSREPR (JEDEN REKORD D NA GRUPE)
//*           SCDS Z OBECNYMI (AKTYWNYMI) RUTYNAMI ACS
//* WYNIK   : TESTBED  - PDS Z TESTAMI (MEMBER = PRFX + NUMER)
//*           BASELIST - LISTING TESTU NA OBECNYCH RUTYNACH (BAZA
//*                      DLA ACSTCMP)
//*           W TESTACH ZAPISANE WYNIKI OCZEKIWANE = WYNIKI BAZOWE
//*
//* PARAMETRY (SET):
//*   PFX     - PREFIKS TSO (PROFILE PREFIX). ZBIORY NAVIQUEST
//*             PODAWANE BEZ APOSTROFOW = PFX.NAZWA
//*   NQPLIB  - PANELE ISMF/NAVIQUEST (PLIB1 W ACBJBAOB)
//*   ISPTABL - TABELE ISPF UZYTKOWNIKA (TABL2 W ACBJBAOB; ZBIOR
//*             MUSI ISTNIEC, DCB JAK SYS1.DGTTLIB)
//*   REPDCOL - MALY DCOLLECT Z ACSREPR (PELNA NAZWA)
//*   NTEST   - MAKS. LICZBA TESTOW: >= LICZBA GRUP Z RAPORTU RPTG
//*   PRFX    - PREFIKS MEMBEROW TESTOW (1-4 ZNAKI; KROTKI PREFIKS
//*             ZOSTAWIA WIECEJ MIEJSCA NA NUMER)
//*   SCDSOLD - SCDS Z OBECNYMI RUTYNAMI (PELNA NAZWA). TYLKO CZYTANY
//*   TESTBED, BASELIST, CMPLIST, EXCPPDS - NAZWY BEZ PFX
//*   TBCYL, TBDIR - CYLINDRY I BLOKI KATALOGU TESTBED (IBM: 1000
//*             TESTOW TO OK. 8 CYL 3380 I 52 BLOKI)
//*   XCPSPC  - SPACE PDS WYJATKOW (SCIEZKI PRIM,SEC,BLOKI KATALOGU);
//*             PRZY BAZIE WYJATKIEM JEST KAZDY TEST
//*
//* KROKI:
//*   DELTB   - USUNIECIE STAREGO TESTBED
//*   ALLOCTB - NOWY TESTBED (PDS FB 80)
//*   GENTEST - ACBQBAG1: TESTY Z REPDCOL
//*   TESTBAS - ACBQBAIA: TEST RUTYN Z SCDSOLD -> BASELIST
//*   CMPBAS  - ACBQBAC1: BASELIST Z BASELIST. NOWE TESTY NIE MAJA
//*             WYNIKOW OCZEKIWANYCH, WIEC SA WYJATKAMI
//*   UPDBAS  - ACBQBAU1: WYNIKI BAZOWE -> OCZEKIWANE W TESTBED
//*   PRTBAS  - DRUK LISTINGU BAZOWEGO
//* WARUNKI: KROKI NAVIQUEST POMIJANE, GDY WCZESNIEJ RC > 8
//* (NAVIQUEST MOZE KONCZYC SIE RC 4/8 PRZY OSTRZEZENIACH I
//* WYJATKACH - TO NIE BLAD).
//*
//* DO WERYFIKACJI PO PIERWSZYM PRZEBIEGU:
//* - CZY NAZWY MEMBEROW ACBQBAG1 MIESZCZA SIE PRZY NTEST > 9999
//* - CZY CMPBAS POKAZUJE TESTY JAKO WYJATKI, A PO UPDBAS MEMBERY
//*   TESTBED MAJA WYNIKI OCZEKIWANE (DC/SC/MC/SG)
//* - JAKIE ZMIENNE ACBQBAG1 WPISUJE DO TESTU (KLASY? ROZMIAR?
//*   UNIT?) - OD TEGO ZALEZY PARAMETR KLASY W ACSREPR
//*
//* PROCEDURA ACBJBAOB Z SYS1.SACBCNTL (JCLLIB PONIZEJ). PRZYKLADY
//* IBM: ACBJBAG1, ACBJBAIC, ACBJBAC1, ACBJBAC2, ACBJBAX1, ACBJBAU2.
//*-------------------------------------------------------------------
//* EXPORT: BEZ NIEGO SYMBOLS=JCLONLY NIE PODSTAWIA &PFX ITD.
//* W DANYCH IN-STREAM (SYSTSIN). MUSI BYC PRZED SET.
//         EXPORT SYMLIST=(PFX,REPDCOL,NTEST,PRFX,SCDSOLD,TESTBED,
//             BASELIST,CMPLIST,EXCPPDS,XCPSPC)
//         SET PFX=HLQ
//         SET REPDCOL='HLQ.ACSTEST.DCOLREP'
//         SET NTEST=9999
//         SET PRFX=R
//         SET SCDSOLD='HLQ.SMS.SCDS'
//         SET TESTBED='ACSTEST.TESTBED'
//         SET BASELIST='ACSTEST.BASE.LIST'
//         SET CMPLIST='ACSTEST.CMP.LIST'
//         SET EXCPPDS='ACSTEST.EXCP'
//         SET XCPSPC='15,15,300'
//         SET TBCYL=10
//         SET TBDIR=300
//         SET NQPLIB='SYS1.DGTPLIB'
//         SET ISPTABL='HLQ.TEST.ISPTABL'
//*
//* USUNIECIE STAREGO TESTBED (BRAK ZBIORU - RC 0)
//DELTB    EXEC PGM=IEFBR14
//TB       DD DSN=&PFX..&TESTBED,DISP=(MOD,DELETE),UNIT=SYSDA,
//            SPACE=(TRK,0)
//*
//ALLOCTB  EXEC PGM=IEFBR14
//TB       DD DSN=&PFX..&TESTBED,DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(&TBCYL,&TBCYL,&TBDIR)),
//            RECFM=FB,LRECL=80,BLKSIZE=0
//*
//* TESTY Z REPDCOL: PARAMETRY ACBQBAG1 - DCOLLECT, LICZBA TESTOW,
//* PREFIKS MEMBEROW, TESTBED, Y = ZASTAP ZAWARTOSC
//GENTEST  EXEC ACBJBAOB,PLIB1=&NQPLIB,TABL2=&ISPTABL,
//             COND=(8,LT)
//SYSTSIN  DD *,SYMBOLS=JCLONLY
PROFILE PREFIX(&PFX)
ISPSTART CMD(%ACBQBAG1 +
'&REPDCOL' +
&NTEST &PRFX +
'&PFX..&TESTBED' Y) +
BATSCRW(132) BATSCRD(27) BREDIMAX(3) BDISPMAX(99999999)
/*
//*
//* TEST WSZYSTKICH TESTOW NA OBECNYCH RUTYNACH -> BASELIST
//TESTBAS  EXEC ACBJBAOB,PLIB1=&NQPLIB,TABL2=&ISPTABL,
//             COND=(8,LT)
//SYSTSIN  DD *,SYMBOLS=JCLONLY
PROFILE PREFIX(&PFX)
DEL &BASELIST
ISPSTART CMD(ACBQBAIA +
SCDSNAME('&SCDSOLD') +
TESTBED(&TESTBED) MEMBER(*) +
LISTNAME(&BASELIST) +
DC(Y) SC(Y) MC(Y) SG(Y)) +
NEWAPPL(DGT) BATSCRW(132) BATSCRD(27) BREDIMAX(3) BDISPMAX(99999999)
/*
//*
//* POROWNANIE BASELIST Z BASELIST: WYJATKI = TESTY BEZ WYNIKOW
//* OCZEKIWANYCH (WSZYSTKIE NOWE). WYNIK: CMPLIST, EXCPPDS
//CMPBAS   EXEC ACBJBAOB,PLIB1=&NQPLIB,TABL2=&ISPTABL,
//             COND=(8,LT)
//SYSTSIN  DD *,SYMBOLS=JCLONLY
PROFILE PREFIX(&PFX)
DEL &CMPLIST
DEL &EXCPPDS
ISPSTART CMD(%ACBQBAC1 +
BASELIST(&BASELIST) +
NEWLIST(&BASELIST) +
TESTBED(&TESTBED) +
RSLTDSN(&CMPLIST) +
XCPTPDS(&EXCPPDS) +
XCPSPACE(&XCPSPC)) +
BATSCRW(132) BATSCRD(27) BREDIMAX(3) BDISPMAX(99999999)
/*
//*
//* WYNIKI BAZOWE -> WYNIKI OCZEKIWANE W MEMBRACH TESTBED
//UPDBAS   EXEC ACBJBAOB,PLIB1=&NQPLIB,TABL2=&ISPTABL,
//             COND=(8,LT)
//SYSTSIN  DD *,SYMBOLS=JCLONLY
PROFILE PREFIX(&PFX)
ISPSTART CMD(%ACBQBAU1 +
NEWLIST(&BASELIST) +
XCPTPDS(&EXCPPDS) +
TESTBED(&TESTBED) +
RSLTDSN(&CMPLIST)) +
BATSCRW(132) BATSCRD(27) BREDIMAX(3) BDISPMAX(99999999)
/*
//*
//PRTBAS   EXEC PGM=IEBGENER,COND=(8,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DISP=SHR,DSN=&PFX..&BASELIST
//SYSUT2   DD SYSOUT=*
