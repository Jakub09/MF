  INCLUDE COND=(D_Q2,GE,310,9,CH,AND,D_Q2,LE,382,9,CH,AND,
                (454,9,CH,EQ,C' ',OR,454,9,CH,EQ,194,9,CH),AND,
                D_Q3,GE,319,9,CH,AND,D_Q3,LE,391,9,CH,AND,
                (463,9,CH,EQ,C' ',OR,463,9,CH,EQ,203,9,CH),AND,
                D_Q4,GE,328,9,CH,AND,D_Q4,LE,400,9,CH,AND,
                (472,9,CH,EQ,C' ',OR,472,9,CH,EQ,212,9,CH),AND,
                D_Q5,GE,337,9,CH,AND,D_Q5,LE,409,9,CH,AND,
                (481,9,CH,EQ,C' ',OR,481,9,CH,EQ,221,9,CH),AND,
                D_Q6,GE,346,9,CH,AND,D_Q6,LE,418,9,CH,AND,
                (490,9,CH,EQ,C' ',OR,490,9,CH,EQ,230,9,CH),AND,
                167,9,CH,GE,355,9,CH,AND,167,9,CH,LE,427,9,CH,AND,
                176,9,CH,GE,364,9,CH,AND,176,9,CH,LE,436,9,CH,AND,
                (508,9,CH,EQ,C' ',OR,508,9,CH,EQ,248,9,CH))
