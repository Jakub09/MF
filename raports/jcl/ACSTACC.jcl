//ACSTACC JOB (ACCT),'ACS TEST ACCEPT',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//NQPROC   JCLLIB ORDER=(SYS1.SACBCNTL)
//*-------------------------------------------------------------------
//* TESTY ACS 5/5: AKCEPTACJA WYNIKOW ZMIENIONYCH RUTYN (NOWA BAZA)
//*
//* URUCHAMIAJ DOPIERO, GDY WYJATKI Z ACSTCMP SA ZAMIERZONE (TYLKO
//* GRUPY, KTORE MIALY ZMIENIC KLASY/SG). PO AKCEPTACJI KOLEJNY
//* PRZEBIEG ACSTCMP POROWNUJE Z NOWYMI WYNIKAMI.
//*
//* WEJSCIE : NEWLIST, CMPLIST, EXCPPDS Z JOBA ACSTCMP
//* WYNIK   : TESTBED - WYNIKI OCZEKIWANE = WYNIKI Z NEWLIST
//*           BASELIST - KOPIA NEWLIST (BAZA DLA ACSTCMP)
//*
//* PARAMETRY (SET):
//*   PFX     - PREFIKS TSO (PROFILE PREFIX). ZBIORY NAVIQUEST
//*             PODAWANE BEZ APOSTROFOW = PFX.NAZWA
//*   NQPLIB  - PANELE ISMF/NAVIQUEST (PLIB1 W ACBJBAOB)
//*   ISPTABL - TABELE ISPF UZYTKOWNIKA (TABL2 W ACBJBAOB; ZBIOR
//*             MUSI ISTNIEC, DCB JAK SYS1.DGTTLIB)
//*   TESTBED, BASELIST, NEWLIST, CMPLIST, EXCPPDS - JAK W ACSTCMP
//*
//* KROKI:
//*   UPDNEW - ACBQBAU1: WYNIKI Z NEWLIST -> OCZEKIWANE W TESTBED
//*   CPYBAS - NEWLIST -> BASELIST (GDY UPDNEW RC <= 8)
//*
//* NOWA ZMIANA W ACS PO WDROZENIU POPRZEDNIEJ: LEPIEJ ZACZAC OD
//* ACSQLST (NOWE MASKI = NOWE GRUPY) NIZ DOKLADAC DO STAREJ BAZY.
//*
//* PROCEDURA ACBJBAOB Z SYS1.SACBCNTL (JCLLIB PONIZEJ). PRZYKLADY
//* IBM: ACBJBAG1, ACBJBAIC, ACBJBAC1, ACBJBAC2, ACBJBAX1, ACBJBAU2.
//*-------------------------------------------------------------------
//* EXPORT: BEZ NIEGO SYMBOLS=JCLONLY NIE PODSTAWIA &PFX ITD.
//* W DANYCH IN-STREAM (SYSTSIN). MUSI BYC PRZED SET.
//         EXPORT SYMLIST=(PFX,TESTBED,NEWLIST,CMPLIST,EXCPPDS)
//         SET PFX=HLQ
//         SET TESTBED='ACSTEST.TESTBED'
//         SET BASELIST='ACSTEST.BASE.LIST'
//         SET NEWLIST='ACSTEST.NEW.LIST'
//         SET CMPLIST='ACSTEST.CMP.LIST'
//         SET EXCPPDS='ACSTEST.EXCP'
//         SET NQPLIB='SYS1.DGTPLIB'
//         SET ISPTABL='HLQ.TEST.ISPTABL'
//*
//* WYNIKI Z NEWLIST -> WYNIKI OCZEKIWANE W TESTBED
//UPDNEW   EXEC ACBJBAOB,PLIB1=&NQPLIB,TABL2=&ISPTABL
//SYSTSIN  DD *,SYMBOLS=JCLONLY
PROFILE PREFIX(&PFX)
ISPSTART CMD(%ACBQBAU1 +
NEWLIST(&NEWLIST) +
XCPTPDS(&EXCPPDS) +
TESTBED(&TESTBED) +
RSLTDSN(&CMPLIST)) +
BATSCRW(132) BATSCRD(27) BREDIMAX(3) BDISPMAX(99999999)
/*
//*
//* NEWLIST -> BASELIST (NADPISANIE)
//CPYBAS   EXEC PGM=IEBGENER,COND=(8,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DISP=SHR,DSN=&PFX..&NEWLIST
//SYSUT2   DD DISP=OLD,DSN=&PFX..&BASELIST
