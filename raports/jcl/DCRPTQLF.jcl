//DCRPTQLF JOB (ACCT),'DCOLLECT QUAL RPT',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*-------------------------------------------------------------------
//* RAPORT 4: KWALIFIKATORY WYROZNIAJACE MALE ZBIORY
//*
//* WEJSCIE : WYNIK IDCAMS DCOLLECT (UZYWANE SA REKORDY TYPU 'D')
//* SYMBOLE : DCOL32.SYM (HEADER, TYPED) + DCRWORK, DCRQLF (RPTSYM)
//* WYNIK   : DD RPT4M - MASKI KANDYDACI (JAK RAPORT 3, POZIOM LVL)
//*           DD RPT4  - DLA KAZDEJ MASKI: KWALIFIKATORY Z POZYCJI ZA
//*                      MASKA, ILE MALYCH / DUZYCH ZBIOROW JE MA
//*
//* PARAMETRY (SET):
//*   LVL   - POZIOM MASKI (2-6), JEDEN POZIOM NA URUCHOMIENIE
//*   PROG  - MALY ZBIOR = ALOKACJA <= PROG SCIEZEK (3390)
//*   PCT   - MASKA KANDYDAT, GDY % MALYCH ZBIOROW >= PCT
//*   MINDS - MASKA KANDYDAT, GDY LICZBA ZBIOROW >= MINDS
//*   MAXDS -                              I         <= MAXDS
//*   QPCT  - KWALIFIKATOR W RAPORCIE, GDY % MALYCH WSROD ZBIOROW
//*           Z TYM KWALIFIKATOREM >= QPCT
//*   QMIN  - ... I GDY WYSTEPUJE W CO NAJMNIEJ QMIN MALYCH ZBIORACH
//*           (QPCT=0 I QMIN=1 POKAZUJE WSZYSTKIE KWALIFIKATORY)
//*
//* - POZYCJA = NUMER KWALIFIKATORA W NAZWIE (1-22); POZYCJE 1..LVL
//*   TWORZA MASKE, WIEC SA POMIJANE
//* - SCIEZKI = ROUND(ALOKACJA_KB * 1024 / 56664)
//* - KOLEJNOSC W MASCE: NAJWIECEJ MALYCH ZBIOROW NA GORZE
//* - ZBIOR WIELOWOLUMENOWY LICZONY RAZ (SUMA ZE WSZYSTKICH VOLUMENOW)
//* - VSAM: KOMPONENTY (.DATA/.INDEX) LICZONE JAKO OSOBNE ZBIORY
//*-------------------------------------------------------------------
//* EXPORT: BEZ NIEGO SYMBOLS=JCLONLY NIE PODSTAWIA &LVL ITD.
//* W DANYCH IN-STREAM (SYMNAMES, TOOLIN). MUSI BYC PRZED SET.
//         EXPORT SYMLIST=(LVL,PROG,PCT,MINDS,MAXDS,QPCT,QMIN)
//         SET DCOLDSN='HLQ.DCOLLECT.OUTPUT'
//         SET SYMLIB='HLQ.DCOL32.SYM'
//         SET RPTSYM=&SYMLIB    BIBLIOTEKA DCRWORK/DCRQLF
//         SET LVL=3
//         SET PROG=2
//         SET PCT=80
//         SET MINDS=50
//         SET MAXDS=999999999
//         SET QPCT=90
//         SET QMIN=10
//*
//RPTQLF   EXEC PGM=ICETOOL
//TOOLMSG  DD SYSOUT=*
//DFSMSG   DD SYSOUT=*
//SYMNOUT  DD SYSOUT=*
//SYMNAMES DD DISP=SHR,DSN=&SYMLIB(HEADER)
//         DD DISP=SHR,DSN=&SYMLIB(TYPED)
//         DD DISP=SHR,DSN=&RPTSYM(DCRWORK)
//         DD DISP=SHR,DSN=&RPTSYM(DCRQLF)
//         DD *,SYMBOLS=JCLONLY
* PARAMETRY Z JCL (SET)
L_LVL,C'&LVL'
P_LVLN,+&LVL
P_TRK,+&PROG
P_PCT,+&PCT
P_MIND,+&MINDS
P_MAXD,+&MAXDS
P_QPCT,+&QPCT
P_QMIN,+&QMIN
//DCOLIN   DD DISP=SHR,DSN=&DCOLDSN
//EXTR     DD DSN=&&EXTR,DISP=(NEW,DELETE,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(10,50),RLSE)
//DSNL     DD DSN=&&DSNL,DISP=(NEW,DELETE,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(10,50),RLSE)
//CAND     DD DSN=&&CAND,DISP=(NEW,DELETE,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(1,10),RLSE)
//DSC      DD DSN=&&DSC,DISP=(NEW,DELETE,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(10,50),RLSE)
//QX       DD DSN=&&QX,DISP=(NEW,DELETE,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(50,200),RLSE)
//QSUM     DD DSN=&&QSUM,DISP=(NEW,DELETE,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(5,50),RLSE)
//QSRT     DD DSN=&&QSRT,DISP=(NEW,DELETE,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(5,50),RLSE)
//RPT4M    DD SYSOUT=*
//RPT4     DD SYSOUT=*
//TOOLIN   DD *,SYMBOLS=JCLONLY
* 1. REKORDY 'D' -> JEDEN REKORD NA ZBIOR (EXTR)
  SORT FROM(DCOLIN) USING(EXT1)
* 2. MASKA POZIOMU LVL + ZNACZNIK MALY/DUZY DLA KAZDEGO ZBIORU (DSNL)
  COPY FROM(EXTR) USING(MSKL)
* 3. MASKI KANDYDACI: % MALYCH >= PCT, MINDS <= ZBIOROW <= MAXDS
  SORT FROM(DSNL) USING(CND1)
  DISPLAY FROM(CAND) LIST(RPT4M) -
    TITLE('MASKI KANDYDACI L&LVL (ALOK <= &PROG TRK)') -
    DATE TIME PAGE BLANK WIDTH(133) -
    HEADER('Maska')    ON(C_MASK) -
    HEADER('Zbiorow')  ON(C_COUNT) -
    HEADER('Malych')   ON(C_SMCNT) -
    HEADER('% malych') ON(C_PCT)
* 4. ZBIORY Z MASEK KANDYDATOW (DSC)
  COPY JKFROM TO(DSC) USING(JNC1)
* 5. ROZBICIE NAZWY: JEDEN REKORD NA KWALIFIKATOR (QX)
  COPY FROM(DSC) USING(EXPL)
* 6. SUMY WG MASKA+POZYCJA+KWALIFIKATOR, FILTR QPCT/QMIN (QSUM)
  SORT FROM(QX) USING(QSM1)
  SORT FROM(QSUM) TO(QSRT) USING(QSR1)
  DISPLAY FROM(QSRT) LIST(RPT4) -
    TITLE('KWALIFIKATORY MALYCH ZBIOROW L&LVL (<= &PROG TRK)') -
    DATE TIME PAGE BLANK WIDTH(133) -
    BREAK(Q_MASK) BTITLE('Maska:') -
    HEADER('Poz.')         ON(Q_POS) -
    HEADER('Kwalifikator') ON(Q_QUAL) -
    HEADER('Malych')       ON(Q_SMALL) -
    HEADER('Duzych')       ON(Q_LARGE) -
    HEADER('% malych')     ON(Q_PCT)
/*
//EXT1CNTL DD *
* TYLKO REKORDY AKTYWNYCH ZBIOROW (TYP 'D')
  INCLUDE COND=(DCURCTYP,EQ,DCUDATAT)
* UKLAD ROBOCZY + WYBOR POLA PRZESTRZENI: 63-BIT / 31-BIT / 0
  INREC IFTHEN=(WHEN=INIT,
          BUILD=(1,4,5:ZD15_0,20:ZD15_0,35:DCDMGTCL,65:DCDDSNAM,
                 109:DCDFLAG2,110:DCDFLAG5,111:DCDALLSP,115:DCDUSESP,
                 119:DCDALLSX,127:DCDUSESX)),
        IFTHEN=(WHEN=(W_FLAG5,EQ,DCDALLFX),
          OVERLAY=(5:W_ALLSX,TO=ZD,LENGTH=15),HIT=NEXT),
        IFTHEN=(WHEN=(W_FLAG5,NE,DCDALLFX,AND,W_FLAG2,EQ,DCDALLFG),
          OVERLAY=(5:W_ALLSP,TO=ZD,LENGTH=15),HIT=NEXT),
        IFTHEN=(WHEN=(W_FLAG5,EQ,DCDUSEFX),
          OVERLAY=(20:W_USESX,TO=ZD,LENGTH=15),HIT=NEXT),
        IFTHEN=(WHEN=(W_FLAG5,NE,DCDUSEFX,AND,W_FLAG2,EQ,DCDUSEFG),
          OVERLAY=(20:W_USESP,TO=ZD,LENGTH=15))
* ZBIOR WIELOWOLUMENOWY -> JEDEN REKORD, PRZESTRZEN ZSUMOWANA
  SORT FIELDS=(W_DSNAM,A)
  SUM FIELDS=(W_ALLKB,W_USEKB)
* VB -> FB 104
  OUTFIL FNAMES=EXTR,VTOF,BUILD=(5,104)
/*
//MSKLCNTL DD *
* KWALIFIKATORY 1-6 (FIXLEN=9 = 8 ZNAKOW + SPACJA JAKO SEPARATOR),
* '**' NA POZ. 56, SCIEZKI, ZNACZNIK MALY/DUZY.
* DLA POZIOMU LVL: KWALIFIKATORY > LVL WYCZYSZCZONE, D_VALID=Y GDY
* ZBIOR MA CO NAJMNIEJ LVL KWALIFIKATOROW.
  INREC IFTHEN=(WHEN=INIT,
          PARSE=(%01=(ABSPOS=61,ENDBEFR=C'.',FIXLEN=9),
                 %02=(ENDBEFR=C'.',FIXLEN=9),
                 %03=(ENDBEFR=C'.',FIXLEN=9),
                 %04=(ENDBEFR=C'.',FIXLEN=9),
                 %05=(ENDBEFR=C'.',FIXLEN=9),
                 %06=(ENDBEFR=C'.',FIXLEN=9)),
          BUILD=(1:%01,%02,%03,%04,%05,%06,56:C'**',61:L_LVL,
                 62:C'N',63:X_ALLKB,78:ZD15_0,93:ZD15_0,108:ZD15_1,
                 123:X_DSNAM)),
        IFTHEN=(WHEN=INIT,
          OVERLAY=(78:(D_ALLKB,MUL,+1024,ADD,+28332),DIV,+56664,
                      TO=ZD,LENGTH=15)),
        IFTHEN=(WHEN=(D_TRK,LE,P_TRK),
          OVERLAY=(93:ZD15_1,108:ZD15_0),HIT=NEXT),
        IFTHEN=(WHEN=(D_LVL,EQ,C'2',AND,D_Q2,NE,C' '),
          OVERLAY=(19:36X,62:C'Y')),
        IFTHEN=(WHEN=(D_LVL,EQ,C'3',AND,D_Q3,NE,C' '),
          OVERLAY=(28:27X,62:C'Y')),
        IFTHEN=(WHEN=(D_LVL,EQ,C'4',AND,D_Q4,NE,C' '),
          OVERLAY=(37:18X,62:C'Y')),
        IFTHEN=(WHEN=(D_LVL,EQ,C'5',AND,D_Q5,NE,C' '),
          OVERLAY=(46:9X,62:C'Y')),
        IFTHEN=(WHEN=(D_LVL,EQ,C'6',AND,D_Q6,NE,C' '),
          OVERLAY=(62:C'Y'))
* MASKA: SPACJE MIEDZY KWALIFIKATORAMI -> '.'
  OUTREC OVERLAY=(1:D_MASK,SQZ=(SHIFT=LEFT,MID=C'.'))
  OUTFIL FNAMES=DSNL,INCLUDE=(D_VALID,EQ,C'Y')
/*
//CND1CNTL DD *
  INREC BUILD=(1:D_MASK,61:ZD15_1,76:D_SMALL)
  SORT FIELDS=(C_MASK,A)
  SUM FIELDS=(C_COUNT,C_SMCNT)
  OUTREC OVERLAY=(91:(C_SMCNT,MUL,+200,ADD,C_COUNT),
                     DIV,(C_COUNT,MUL,+2),TO=ZD,LENGTH=3)
  OUTFIL FNAMES=CAND,
    INCLUDE=(C_PCT,GE,P_PCT,AND,
             C_COUNT,GE,P_MIND,AND,C_COUNT,LE,P_MAXD)
/*
//JNC1CNTL DD *
* TYLKO ZBIORY, KTORYCH MASKA JEST NA LISCIE KANDYDATOW
  JOINKEYS F1=DSNL,FIELDS=(1,60,A)
  JOINKEYS F2=CAND,FIELDS=(1,60,A)
  REFORMAT FIELDS=(F1:1,166)
/*
//EXPLCNTL DD *
* KWALIFIKATORY 1-22 -> 22 REKORDY NA ZBIOR (PUSTE ODRZUCA QSM1)
  OUTFIL FNAMES=QX,
    PARSE=(%01=(ABSPOS=123,ENDBEFR=C'.',FIXLEN=8),
           %02=(ENDBEFR=C'.',FIXLEN=8),
           %03=(ENDBEFR=C'.',FIXLEN=8),
           %04=(ENDBEFR=C'.',FIXLEN=8),
           %05=(ENDBEFR=C'.',FIXLEN=8),
           %06=(ENDBEFR=C'.',FIXLEN=8),
           %07=(ENDBEFR=C'.',FIXLEN=8),
           %08=(ENDBEFR=C'.',FIXLEN=8),
           %09=(ENDBEFR=C'.',FIXLEN=8),
           %10=(ENDBEFR=C'.',FIXLEN=8),
           %11=(ENDBEFR=C'.',FIXLEN=8),
           %12=(ENDBEFR=C'.',FIXLEN=8),
           %13=(ENDBEFR=C'.',FIXLEN=8),
           %14=(ENDBEFR=C'.',FIXLEN=8),
           %15=(ENDBEFR=C'.',FIXLEN=8),
           %16=(ENDBEFR=C'.',FIXLEN=8),
           %17=(ENDBEFR=C'.',FIXLEN=8),
           %18=(ENDBEFR=C'.',FIXLEN=8),
           %19=(ENDBEFR=C'.',FIXLEN=8),
           %20=(ENDBEFR=C'.',FIXLEN=8),
           %21=(ENDBEFR=C'.',FIXLEN=8),
           %22=(ENDBEFR=C'.',FIXLEN=8)),
    BUILD=(D_MASK,C'01',%01,D_SMLG,ZD15_1,/,
           D_MASK,C'02',%02,D_SMLG,ZD15_1,/,
           D_MASK,C'03',%03,D_SMLG,ZD15_1,/,
           D_MASK,C'04',%04,D_SMLG,ZD15_1,/,
           D_MASK,C'05',%05,D_SMLG,ZD15_1,/,
           D_MASK,C'06',%06,D_SMLG,ZD15_1,/,
           D_MASK,C'07',%07,D_SMLG,ZD15_1,/,
           D_MASK,C'08',%08,D_SMLG,ZD15_1,/,
           D_MASK,C'09',%09,D_SMLG,ZD15_1,/,
           D_MASK,C'10',%10,D_SMLG,ZD15_1,/,
           D_MASK,C'11',%11,D_SMLG,ZD15_1,/,
           D_MASK,C'12',%12,D_SMLG,ZD15_1,/,
           D_MASK,C'13',%13,D_SMLG,ZD15_1,/,
           D_MASK,C'14',%14,D_SMLG,ZD15_1,/,
           D_MASK,C'15',%15,D_SMLG,ZD15_1,/,
           D_MASK,C'16',%16,D_SMLG,ZD15_1,/,
           D_MASK,C'17',%17,D_SMLG,ZD15_1,/,
           D_MASK,C'18',%18,D_SMLG,ZD15_1,/,
           D_MASK,C'19',%19,D_SMLG,ZD15_1,/,
           D_MASK,C'20',%20,D_SMLG,ZD15_1,/,
           D_MASK,C'21',%21,D_SMLG,ZD15_1,/,
           D_MASK,C'22',%22,D_SMLG,ZD15_1)
/*
//QSM1CNTL DD *
* POMIJAMY PUSTE KWALIFIKATORY I POZYCJE 1..LVL (CZESC MASKI)
  INCLUDE COND=(Q_QUAL,NE,C' ',AND,Q_POS,GT,P_LVLN)
  SORT FIELDS=(Q_MASK,A,Q_POS,A,Q_QUAL,A)
  SUM FIELDS=(Q_SMALL,Q_LARGE,Q_TOTAL)
  OUTREC OVERLAY=(116:(Q_SMALL,MUL,+200,ADD,Q_TOTAL),
                      DIV,(Q_TOTAL,MUL,+2),TO=ZD,LENGTH=3)
  OUTFIL FNAMES=QSUM,
    INCLUDE=(Q_PCT,GE,P_QPCT,AND,Q_SMALL,GE,P_QMIN)
/*
//QSR1CNTL DD *
* W KAZDEJ MASCE: NAJWIECEJ MALYCH ZBIOROW NA GORZE
  SORT FIELDS=(Q_MASK,A,Q_SMALL,D,Q_POS,A,Q_QUAL,A)
/*
