//DCRPTMC  JOB (ACCT),'DCOLLECT MC RPT',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*-------------------------------------------------------------------
//* RAPORT 1: LICZBA ZBIOROW I ZAJETOSC WG MANAGEMENT CLASS
//*
//* WEJSCIE : WYNIK IDCAMS DCOLLECT (UZYWANE SA REKORDY TYPU 'D')
//* SYMBOLE : DCOL32.SYM (HEADER, TYPED) + DCRWORK, DCRMC (RPTSYM)
//* WYNIK   : DD RPT1
//*
//* - ZBIOR WIELOWOLUMENOWY LICZONY RAZ (SUMA ZE WSZYSTKICH VOLUMENOW)
//* - ALOKACJA/UZYCIE: POLA 63-BIT (DCDALLSX/DCDUSESX) GDY WAZNE,
//*   W PRZECIWNYM RAZIE 31-BIT (DCDALLSP/DCDUSESP), INACZEJ 0
//* - VSAM: DCOLLECT PODAJE KOMPONENTY (.DATA/.INDEX) - KAZDY LICZONY
//*   JAKO OSOBNY ZBIOR
//* - ZBIORY BEZ MC (NON-SMS) -> POZYCJA '(BRAK MC / NON-SMS)'
//*-------------------------------------------------------------------
//         SET DCOLDSN='HLQ.DCOLLECT.OUTPUT'
//         SET SYMLIB='HLQ.DCOL32.SYM'
//         SET RPTSYM=&SYMLIB    BIBLIOTEKA DCRWORK/DCRMC
//*
//RPTMC    EXEC PGM=ICETOOL
//TOOLMSG  DD SYSOUT=*
//DFSMSG   DD SYSOUT=*
//SYMNOUT  DD SYSOUT=*
//SYMNAMES DD DISP=SHR,DSN=&SYMLIB(HEADER)
//         DD DISP=SHR,DSN=&SYMLIB(TYPED)
//         DD DISP=SHR,DSN=&RPTSYM(DCRWORK)
//         DD DISP=SHR,DSN=&RPTSYM(DCRMC)
//DCOLIN   DD DISP=SHR,DSN=&DCOLDSN
//EXTR     DD DSN=&&EXTR,DISP=(NEW,DELETE,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(10,50),RLSE)
//MCSUM    DD DSN=&&MCSUM,DISP=(NEW,DELETE,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(1,5),RLSE)
//RPT1     DD SYSOUT=*
//TOOLIN   DD *
* 1. REKORDY 'D' -> JEDEN REKORD NA ZBIOR (EXTR)
  SORT FROM(DCOLIN) USING(EXT1)
* 2. SUMY WG MANAGEMENT CLASS (MCSUM)
  SORT FROM(EXTR) TO(MCSUM) USING(MCS1)
* 3. RAPORT
  DISPLAY FROM(MCSUM) LIST(RPT1) -
    TITLE('DCOLLECT - ZBIORY WG MANAGEMENT CLASS') -
    DATE TIME PAGE BLANK WIDTH(133) -
    HEADER('Management class') ON(M_MGTCL) -
    HEADER('Liczba zbiorow')   ON(M_COUNT) -
    HEADER('Alokowane MB')     ON(M_ALLMB) -
    HEADER('Uzywane MB')       ON(M_USEMB) -
    TOTAL('RAZEM')
/*
//EXT1CNTL DD *
* TYLKO REKORDY AKTYWNYCH ZBIOROW (TYP 'D')
  INCLUDE COND=(DCURCTYP,EQ,DCUDATAT)
* UKLAD ROBOCZY + WYBOR POLA PRZESTRZENI: 63-BIT / 31-BIT / 0
  INREC IFTHEN=(WHEN=INIT,
          BUILD=(1,4,5:ZD15_0,20:ZD15_0,35:DCDMGTCL,65:DCDDSNAM,
                 109:DCDFLAG2,110:DCDFLAG5,111:DCDALLSP,115:DCDUSESP,
                 119:DCDALLSX,127:DCDUSESX)),
        IFTHEN=(WHEN=(W_FLAG5,EQ,DCDALLFX),
          OVERLAY=(5:W_ALLSX,TO=ZD,LENGTH=15),HIT=NEXT),
        IFTHEN=(WHEN=(W_FLAG5,NE,DCDALLFX,AND,W_FLAG2,EQ,DCDALLFG),
          OVERLAY=(5:W_ALLSP,TO=ZD,LENGTH=15),HIT=NEXT),
        IFTHEN=(WHEN=(W_FLAG5,EQ,DCDUSEFX),
          OVERLAY=(20:W_USESX,TO=ZD,LENGTH=15),HIT=NEXT),
        IFTHEN=(WHEN=(W_FLAG5,NE,DCDUSEFX,AND,W_FLAG2,EQ,DCDUSEFG),
          OVERLAY=(20:W_USESP,TO=ZD,LENGTH=15))
* ZBIOR WIELOWOLUMENOWY -> JEDEN REKORD, PRZESTRZEN ZSUMOWANA
  SORT FIELDS=(W_DSNAM,A)
  SUM FIELDS=(W_ALLKB,W_USEKB)
* VB -> FB 104
  OUTFIL FNAMES=EXTR,VTOF,BUILD=(5,104)
/*
//MCS1CNTL DD *
  INREC IFTHEN=(WHEN=INIT,
          BUILD=(1:X_MGTCL,31:ZD15_1,46:X_ALLKB,61:X_USEKB)),
        IFTHEN=(WHEN=(M_MGTCL,EQ,C' '),
          OVERLAY=(1:C'(BRAK MC / NON-SMS)'))
  SORT FIELDS=(M_MGTCL,A)
  SUM FIELDS=(M_COUNT,M_ALLKB,M_USEKB)
* KB -> MB (ZAOKRAGLONE)
  OUTREC OVERLAY=(76:(M_ALLKB,ADD,+512),DIV,+1024,
                     TO=ZD,LENGTH=15,
                  91:(M_USEKB,ADD,+512),DIV,+1024,
                     TO=ZD,LENGTH=15)
/*
