//DCRPTSML JOB (ACCT),'DCOLLECT SMALL RPT',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*-------------------------------------------------------------------
//* RAPORT 3: MASKI, W KTORYCH PRZEWAZAJA MALE ZBIORY
//*
//* WEJSCIE : WYNIK IDCAMS DCOLLECT (UZYWANE SA REKORDY TYPU 'D')
//* SYMBOLE : DCOL32.SYM (HEADER, TYPED) + DCRWORK, DCRSML (RPTSYM)
//* WYNIK   : DD RPTS2 .. RPTS6 - OSOBNY WYDRUK DLA KAZDEGO POZIOMU
//*
//* PARAMETRY (SET):
//*   PROG  - MALY ZBIOR = ALOKACJA <= PROG SCIEZEK (3390)
//*   PCT   - MASKA W RAPORCIE, GDY % MALYCH ZBIOROW >= PCT
//*   MINDS - MASKA W RAPORCIE, GDY LICZBA ZBIOROW >= MINDS
//*   MAXDS -                              I         <= MAXDS
//*
//* - SCIEZKI = ROUND(ALOKACJA_KB * 1024 / 56664)
//* - % MALYCH = ROUND(100 * MALE / WSZYSTKIE), LICZONE PO ZBIORACH
//* - KOLEJNOSC: NAJWIECEJ MALYCH ZBIOROW NA GORZE
//* - ZBIOR WIELOWOLUMENOWY LICZONY RAZ (SUMA ZE WSZYSTKICH VOLUMENOW)
//* - VSAM: KOMPONENTY (.DATA/.INDEX) LICZONE JAKO OSOBNE ZBIORY
//*-------------------------------------------------------------------
//* EXPORT: BEZ NIEGO SYMBOLS=JCLONLY NIE PODSTAWIA &PROG ITD.
//* W DANYCH IN-STREAM (SYMNAMES, TOOLIN). MUSI BYC PRZED SET.
//         EXPORT SYMLIST=(PROG,PCT,MINDS,MAXDS)
//         SET DCOLDSN='HLQ.DCOLLECT.OUTPUT'
//         SET SYMLIB='HLQ.DCOL32.SYM'
//         SET RPTSYM=&SYMLIB    BIBLIOTEKA DCRWORK/DCRSML
//         SET PROG=2
//         SET PCT=80
//         SET MINDS=50
//         SET MAXDS=999999999
//*
//RPTSML   EXEC PGM=ICETOOL
//TOOLMSG  DD SYSOUT=*
//DFSMSG   DD SYSOUT=*
//SYMNOUT  DD SYSOUT=*
//SYMNAMES DD DISP=SHR,DSN=&SYMLIB(HEADER)
//         DD DISP=SHR,DSN=&SYMLIB(TYPED)
//         DD DISP=SHR,DSN=&RPTSYM(DCRWORK)
//         DD DISP=SHR,DSN=&RPTSYM(DCRSML)
//         DD *,SYMBOLS=JCLONLY
* PARAMETRY Z JCL (SET)
P_TRK,+&PROG
P_PCT,+&PCT
P_MIND,+&MINDS
P_MAXD,+&MAXDS
//DCOLIN   DD DISP=SHR,DSN=&DCOLDSN
//EXTR     DD DSN=&&EXTR,DISP=(NEW,DELETE,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(10,50),RLSE)
//PQS      DD DSN=&&PQS,DISP=(NEW,DELETE,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(10,50),RLSE)
//LVSUM    DD DSN=&&LVSUM,DISP=(NEW,DELETE,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(5,50),RLSE)
//LVSRT    DD DSN=&&LVSRT,DISP=(NEW,DELETE,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(5,50),RLSE)
//RPTS2    DD SYSOUT=*
//RPTS3    DD SYSOUT=*
//RPTS4    DD SYSOUT=*
//RPTS5    DD SYSOUT=*
//RPTS6    DD SYSOUT=*
//TOOLIN   DD *,SYMBOLS=JCLONLY
* 1. REKORDY 'D' -> JEDEN REKORD NA ZBIOR (EXTR)
  SORT FROM(DCOLIN) USING(EXT1)
* 2. KWALIFIKATORY 1-6 + ZNACZNIK MALEGO ZBIORU (PQS)
  COPY FROM(EXTR) TO(PQS) USING(PRSE)
* 3. POZIOMY 2-6: SUMY WG MASKI + FILTR (LVSUM), SORT (LVSRT), WYDRUK
  SORT FROM(PQS) USING(SML2)
  SORT FROM(LVSUM) TO(LVSRT) USING(SRTS)
  DISPLAY FROM(LVSRT) LIST(RPTS2) -
    TITLE('MASKI L2 - MALE ZBIORY (ALOK <= &PROG TRK)') -
    DATE TIME PAGE BLANK WIDTH(160) -
    HEADER('Maska')            ON(1,20,CH) -
    HEADER('Zbiorow')          ON(T_COUNT) -
    HEADER('Malych')           ON(T_SMCNT) -
    HEADER('% malych')         ON(T_PCT) -
    HEADER('Alokowane MB')     ON(T_ALLMB) -
    HEADER('Alok. malych MB')  ON(T_SMLMB)
  SORT FROM(PQS) USING(SML3)
  SORT FROM(LVSUM) TO(LVSRT) USING(SRTS)
  DISPLAY FROM(LVSRT) LIST(RPTS3) -
    TITLE('MASKI L3 - MALE ZBIORY (ALOK <= &PROG TRK)') -
    DATE TIME PAGE BLANK WIDTH(160) -
    HEADER('Maska')            ON(1,29,CH) -
    HEADER('Zbiorow')          ON(T_COUNT) -
    HEADER('Malych')           ON(T_SMCNT) -
    HEADER('% malych')         ON(T_PCT) -
    HEADER('Alokowane MB')     ON(T_ALLMB) -
    HEADER('Alok. malych MB')  ON(T_SMLMB)
  SORT FROM(PQS) USING(SML4)
  SORT FROM(LVSUM) TO(LVSRT) USING(SRTS)
  DISPLAY FROM(LVSRT) LIST(RPTS4) -
    TITLE('MASKI L4 - MALE ZBIORY (ALOK <= &PROG TRK)') -
    DATE TIME PAGE BLANK WIDTH(160) -
    HEADER('Maska')            ON(1,38,CH) -
    HEADER('Zbiorow')          ON(T_COUNT) -
    HEADER('Malych')           ON(T_SMCNT) -
    HEADER('% malych')         ON(T_PCT) -
    HEADER('Alokowane MB')     ON(T_ALLMB) -
    HEADER('Alok. malych MB')  ON(T_SMLMB)
  SORT FROM(PQS) USING(SML5)
  SORT FROM(LVSUM) TO(LVSRT) USING(SRTS)
  DISPLAY FROM(LVSRT) LIST(RPTS5) -
    TITLE('MASKI L5 - MALE ZBIORY (ALOK <= &PROG TRK)') -
    DATE TIME PAGE BLANK WIDTH(160) -
    HEADER('Maska')            ON(1,47,CH) -
    HEADER('Zbiorow')          ON(T_COUNT) -
    HEADER('Malych')           ON(T_SMCNT) -
    HEADER('% malych')         ON(T_PCT) -
    HEADER('Alokowane MB')     ON(T_ALLMB) -
    HEADER('Alok. malych MB')  ON(T_SMLMB)
  SORT FROM(PQS) USING(SML6)
  SORT FROM(LVSUM) TO(LVSRT) USING(SRTS)
  DISPLAY FROM(LVSRT) LIST(RPTS6) -
    TITLE('MASKI L6 - MALE ZBIORY (ALOK <= &PROG TRK)') -
    DATE TIME PAGE BLANK WIDTH(160) -
    HEADER('Maska')            ON(1,56,CH) -
    HEADER('Zbiorow')          ON(T_COUNT) -
    HEADER('Malych')           ON(T_SMCNT) -
    HEADER('% malych')         ON(T_PCT) -
    HEADER('Alokowane MB')     ON(T_ALLMB) -
    HEADER('Alok. malych MB')  ON(T_SMLMB)
/*
//EXT1CNTL DD *
* TYLKO REKORDY AKTYWNYCH ZBIOROW (TYP 'D')
  INCLUDE COND=(DCURCTYP,EQ,DCUDATAT)
* UKLAD ROBOCZY + WYBOR POLA PRZESTRZENI: 63-BIT / 31-BIT / 0
  INREC IFTHEN=(WHEN=INIT,
          BUILD=(1,4,5:ZD15_0,20:ZD15_0,35:DCDMGTCL,65:DCDDSNAM,
                 109:DCDFLAG2,110:DCDFLAG5,111:DCDALLSP,115:DCDUSESP,
                 119:DCDALLSX,127:DCDUSESX)),
        IFTHEN=(WHEN=(W_FLAG5,EQ,DCDALLFX),
          OVERLAY=(5:W_ALLSX,TO=ZD,LENGTH=15),HIT=NEXT),
        IFTHEN=(WHEN=(W_FLAG5,NE,DCDALLFX,AND,W_FLAG2,EQ,DCDALLFG),
          OVERLAY=(5:W_ALLSP,TO=ZD,LENGTH=15),HIT=NEXT),
        IFTHEN=(WHEN=(W_FLAG5,EQ,DCDUSEFX),
          OVERLAY=(20:W_USESX,TO=ZD,LENGTH=15),HIT=NEXT),
        IFTHEN=(WHEN=(W_FLAG5,NE,DCDUSEFX,AND,W_FLAG2,EQ,DCDUSEFG),
          OVERLAY=(20:W_USESP,TO=ZD,LENGTH=15))
* ZBIOR WIELOWOLUMENOWY -> JEDEN REKORD, PRZESTRZEN ZSUMOWANA
  SORT FIELDS=(W_DSNAM,A)
  SUM FIELDS=(W_ALLKB,W_USEKB)
* VB -> FB 104
  OUTFIL FNAMES=EXTR,VTOF,BUILD=(5,104)
/*
//PRSECNTL DD *
* KWALIFIKATORY 1-6; FIXLEN=9 ZOSTAWIA SPACJE PO KAZDYM KWALIFIKATORZE
* (SEPARATOR DLA SQZ MID=C'.'). NAZWA JEST NA KONCU REKORDU, WIEC
* OSTATNI KWALIFIKATOR KONCZY SIE NA KONCU REKORDU.
* SCIEZKI = ROUND(KB * 1024 / 56664); MALY ZBIOR GDY SCIEZKI <= PROG
  INREC IFTHEN=(WHEN=INIT,
          PARSE=(%01=(ABSPOS=61,ENDBEFR=C'.',FIXLEN=9),
                 %02=(ENDBEFR=C'.',FIXLEN=9),
                 %03=(ENDBEFR=C'.',FIXLEN=9),
                 %04=(ENDBEFR=C'.',FIXLEN=9),
                 %05=(ENDBEFR=C'.',FIXLEN=9),
                 %06=(ENDBEFR=C'.',FIXLEN=9)),
          BUILD=(1:%01,%02,%03,%04,%05,%06,55:X_ALLKB,70:X_USEKB,
                 85:ZD15_0,100:ZD15_0)),
        IFTHEN=(WHEN=INIT,
          OVERLAY=(85:(S_ALLKB,MUL,+1024,ADD,+28332),DIV,+56664,
                      TO=ZD,LENGTH=15)),
        IFTHEN=(WHEN=(S_TRK,LE,P_TRK),
          OVERLAY=(100:ZD15_1))
/*
//*-------------------------------------------------------------------
//* SMLN: MASKA = KWALIFIKATORY 1..N + '**', SPACJE -> '.' (SQZ MID)
//*       PO SUMOWANIU: % MALYCH, MB I FILTR PCT / MINDS / MAXDS
//*-------------------------------------------------------------------
//SML2CNTL DD *
  INCLUDE COND=(S_Q2,NE,C' ')
  INREC IFTHEN=(WHEN=INIT,
          BUILD=(1:1,18,C'**',61:ZD15_1,76:S_SMALL,91:S_ALLKB,
                 106:S_ALLKB,MUL,S_SMALL,TO=ZD,LENGTH=15)),
        IFTHEN=(WHEN=INIT,
          OVERLAY=(1:T_MASK,SQZ=(SHIFT=LEFT,MID=C'.')))
  SORT FIELDS=(T_MASK,A)
  SUM FIELDS=(T_COUNT,T_SMCNT,T_ALLKB,T_SMLKB)
  OUTREC OVERLAY=(121:(T_SMCNT,MUL,+200,ADD,T_COUNT),
                      DIV,(T_COUNT,MUL,+2),TO=ZD,LENGTH=3,
                  124:(T_ALLKB,ADD,+512),DIV,+1024,
                      TO=ZD,LENGTH=15,
                  139:(T_SMLKB,ADD,+512),DIV,+1024,
                      TO=ZD,LENGTH=15)
  OUTFIL FNAMES=LVSUM,
    INCLUDE=(T_PCT,GE,P_PCT,AND,
             T_COUNT,GE,P_MIND,AND,T_COUNT,LE,P_MAXD)
/*
//SML3CNTL DD *
  INCLUDE COND=(S_Q3,NE,C' ')
  INREC IFTHEN=(WHEN=INIT,
          BUILD=(1:1,27,C'**',61:ZD15_1,76:S_SMALL,91:S_ALLKB,
                 106:S_ALLKB,MUL,S_SMALL,TO=ZD,LENGTH=15)),
        IFTHEN=(WHEN=INIT,
          OVERLAY=(1:T_MASK,SQZ=(SHIFT=LEFT,MID=C'.')))
  SORT FIELDS=(T_MASK,A)
  SUM FIELDS=(T_COUNT,T_SMCNT,T_ALLKB,T_SMLKB)
  OUTREC OVERLAY=(121:(T_SMCNT,MUL,+200,ADD,T_COUNT),
                      DIV,(T_COUNT,MUL,+2),TO=ZD,LENGTH=3,
                  124:(T_ALLKB,ADD,+512),DIV,+1024,
                      TO=ZD,LENGTH=15,
                  139:(T_SMLKB,ADD,+512),DIV,+1024,
                      TO=ZD,LENGTH=15)
  OUTFIL FNAMES=LVSUM,
    INCLUDE=(T_PCT,GE,P_PCT,AND,
             T_COUNT,GE,P_MIND,AND,T_COUNT,LE,P_MAXD)
/*
//SML4CNTL DD *
  INCLUDE COND=(S_Q4,NE,C' ')
  INREC IFTHEN=(WHEN=INIT,
          BUILD=(1:1,36,C'**',61:ZD15_1,76:S_SMALL,91:S_ALLKB,
                 106:S_ALLKB,MUL,S_SMALL,TO=ZD,LENGTH=15)),
        IFTHEN=(WHEN=INIT,
          OVERLAY=(1:T_MASK,SQZ=(SHIFT=LEFT,MID=C'.')))
  SORT FIELDS=(T_MASK,A)
  SUM FIELDS=(T_COUNT,T_SMCNT,T_ALLKB,T_SMLKB)
  OUTREC OVERLAY=(121:(T_SMCNT,MUL,+200,ADD,T_COUNT),
                      DIV,(T_COUNT,MUL,+2),TO=ZD,LENGTH=3,
                  124:(T_ALLKB,ADD,+512),DIV,+1024,
                      TO=ZD,LENGTH=15,
                  139:(T_SMLKB,ADD,+512),DIV,+1024,
                      TO=ZD,LENGTH=15)
  OUTFIL FNAMES=LVSUM,
    INCLUDE=(T_PCT,GE,P_PCT,AND,
             T_COUNT,GE,P_MIND,AND,T_COUNT,LE,P_MAXD)
/*
//SML5CNTL DD *
  INCLUDE COND=(S_Q5,NE,C' ')
  INREC IFTHEN=(WHEN=INIT,
          BUILD=(1:1,45,C'**',61:ZD15_1,76:S_SMALL,91:S_ALLKB,
                 106:S_ALLKB,MUL,S_SMALL,TO=ZD,LENGTH=15)),
        IFTHEN=(WHEN=INIT,
          OVERLAY=(1:T_MASK,SQZ=(SHIFT=LEFT,MID=C'.')))
  SORT FIELDS=(T_MASK,A)
  SUM FIELDS=(T_COUNT,T_SMCNT,T_ALLKB,T_SMLKB)
  OUTREC OVERLAY=(121:(T_SMCNT,MUL,+200,ADD,T_COUNT),
                      DIV,(T_COUNT,MUL,+2),TO=ZD,LENGTH=3,
                  124:(T_ALLKB,ADD,+512),DIV,+1024,
                      TO=ZD,LENGTH=15,
                  139:(T_SMLKB,ADD,+512),DIV,+1024,
                      TO=ZD,LENGTH=15)
  OUTFIL FNAMES=LVSUM,
    INCLUDE=(T_PCT,GE,P_PCT,AND,
             T_COUNT,GE,P_MIND,AND,T_COUNT,LE,P_MAXD)
/*
//SML6CNTL DD *
  INCLUDE COND=(S_Q6,NE,C' ')
  INREC IFTHEN=(WHEN=INIT,
          BUILD=(1:1,54,C'**',61:ZD15_1,76:S_SMALL,91:S_ALLKB,
                 106:S_ALLKB,MUL,S_SMALL,TO=ZD,LENGTH=15)),
        IFTHEN=(WHEN=INIT,
          OVERLAY=(1:T_MASK,SQZ=(SHIFT=LEFT,MID=C'.')))
  SORT FIELDS=(T_MASK,A)
  SUM FIELDS=(T_COUNT,T_SMCNT,T_ALLKB,T_SMLKB)
  OUTREC OVERLAY=(121:(T_SMCNT,MUL,+200,ADD,T_COUNT),
                      DIV,(T_COUNT,MUL,+2),TO=ZD,LENGTH=3,
                  124:(T_ALLKB,ADD,+512),DIV,+1024,
                      TO=ZD,LENGTH=15,
                  139:(T_SMLKB,ADD,+512),DIV,+1024,
                      TO=ZD,LENGTH=15)
  OUTFIL FNAMES=LVSUM,
    INCLUDE=(T_PCT,GE,P_PCT,AND,
             T_COUNT,GE,P_MIND,AND,T_COUNT,LE,P_MAXD)
/*
//SRTSCNTL DD *
* NAJWIECEJ MALYCH ZBIOROW NA GORZE, POTEM WG % MALYCH
  SORT FIELDS=(T_SMCNT,D,T_PCT,D,T_MASK,A)
/*
