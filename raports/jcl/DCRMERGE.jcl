//DCRMERGE JOB (ACCT),'DCOLLECT MERGE',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*-------------------------------------------------------------------
//* POLACZENIE KILKU WYNIKOW DCOLLECT BEZ DUPLIKATOW
//*
//* WEJSCIE : DD DCOLIN - DOWOLNIE WIELE WYNIKOW IDCAMS DCOLLECT
//*           (KONKATENACJA, KOLEJNOSC BEZ ZNACZENIA; SAMA BAZA GDG =
//*           WSZYSTKIE GENERACJE)
//* SYMBOLE : DCOL32.SYM (HEADER, TYPED, TYPEA, TYPEM, TYPEB, TYPEV,
//*           TYPEC, TYPET, TYPEDC) + DCRMRG (RPTSYM)
//* WYNIK   : OUTDSN - JEDEN DCOLLECT, REKORDY BEZ ZMIAN, POSORTOWANE
//*           WG TYPU I NAZWY (WEJSCIE ACMCSV, DCRPT*, ACS*)
//*           DD RPTIN / RPTOUT - LICZBA REKORDOW WG PRZEBIEGU I TYPU
//*           PRZED I PO (DATA RRRRDDD, CZAS W 1/100 S OD POLNOCY)
//*
//* PRZEBIEG DCOLLECT = DATA I CZAS Z NAGLOWKA (DCUTMSTP), TAKIE SAME
//* WE WSZYSTKICH REKORDACH JEDNEGO WYWOLANIA. NOWSZY PRZEBIEG WYGRYWA.
//*
//* PARAMETRY (SET):
//*   OUTDSN - ZBIOR WYNIKOWY (USUWANY NA POCZATKU)
//*   SYMLIB, RPTSYM - BIBLIOTEKI SYMBOLI
//*   KVOL   - CO JEST DUPLIKATEM DLA REKORDOW 'D':
//*     6X       TA SAMA NAZWA. ZOSTAJA REKORDY (WSZYSTKIE WOLUMENY)
//*              Z NAJNOWSZEGO PRZEBIEGU, W KTORYM ZBIOR JEST.
//*              DLA PRZEBIEGOW TYCH SAMYCH DYSKOW Z ROZNYCH DNI:
//*              ZBIOR PRZENIESIONY NA INNY WOLUMEN NIE LICZY SIE DWA
//*              RAZY. ZBIORY JUZ SKASOWANE ZOSTAJA.
//*     DCDVOLSR TA SAMA NAZWA I TEN SAM WOLUMEN. DLA PRZEBIEGOW
//*              ROZNYCH DYSKOW (INNE SYSTEMY, GRUPY): CZESCI ZBIORU
//*              WIELOWOLUMENOWEGO Z ROZNYCH PRZEBIEGOW ZOSTAJA
//*
//* DUPLIKAT DLA POZOSTALYCH TYPOW (NIE ZALEZY OD KVOL):
//*   A             NAZWA KOMPONENTU (VSAM)
//*   M             NAZWA ZBIORU
//*   B             NAZWA ZBIORU + DATA I CZAS KOPII
//*   V             WOLUMEN
//*   C             WOLUMEN + DATA DANYCH
//*   T             RODZAJ TASM
//*   DC SC MC SG VL AG DR LB   NAZWA DEFINICJI
//*   BC CN AI I INNE           CALY TYP: ZOSTAJE NAJNOWSZY PRZEBIEG
//*
//* OGRANICZENIE: LRECL WEJSCIA DO 32632 (ROBOCZO +124 BAJTY)
//*
//* KROKI: DELOUT - USUNIECIE WYNIKU POPRZEDNIEGO PRZEBIEGU
//*        MERGE  - ICETOOL: RAPORT WEJSCIA, LACZENIE, RAPORT WYNIKU
//*-------------------------------------------------------------------
//* EXPORT: BEZ NIEGO SYMBOLS=JCLONLY NIE PODSTAWIA &KVOL W KARTACH
//         EXPORT SYMLIST=(KVOL)
//         SET OUTDSN='HLQ.DCOLLECT.MERGED'
//         SET SYMLIB='HLQ.DCOL32.SYM'
//         SET RPTSYM=&SYMLIB    BIBLIOTEKA DCRMRG
//         SET KVOL=6X
//*
//* USUNIECIE WYNIKU POPRZEDNIEGO PRZEBIEGU (BRAK ZBIORU - RC 0)
//DELOUT   EXEC PGM=IEFBR14
//DCOLOUT  DD DSN=&OUTDSN,DISP=(MOD,DELETE),UNIT=SYSDA,SPACE=(TRK,0)
//*
//MERGE    EXEC PGM=ICETOOL
//TOOLMSG  DD SYSOUT=*
//DFSMSG   DD SYSOUT=*
//SYMNOUT  DD SYSOUT=*
//SYMNAMES DD DISP=SHR,DSN=&SYMLIB(HEADER)
//         DD DISP=SHR,DSN=&SYMLIB(TYPED)
//         DD DISP=SHR,DSN=&SYMLIB(TYPEA)
//         DD DISP=SHR,DSN=&SYMLIB(TYPEM)
//         DD DISP=SHR,DSN=&SYMLIB(TYPEB)
//         DD DISP=SHR,DSN=&SYMLIB(TYPEV)
//         DD DISP=SHR,DSN=&SYMLIB(TYPEC)
//         DD DISP=SHR,DSN=&SYMLIB(TYPET)
//         DD DISP=SHR,DSN=&SYMLIB(TYPEDC)
//         DD DISP=SHR,DSN=&RPTSYM(DCRMRG)
//* WYNIKI DCOLLECT DO POLACZENIA - DOPISZ TYLE DD, ILE TRZEBA
//DCOLIN   DD DISP=SHR,DSN=HLQ.DCOLLECT.OUTPUT1
//         DD DISP=SHR,DSN=HLQ.DCOLLECT.OUTPUT2
//         DD DISP=SHR,DSN=HLQ.DCOLLECT.OUTPUT3
//DCOLOUT  DD DSN=&OUTDSN,DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(100,500),RLSE)
//RPTIN    DD SYSOUT=*
//RPTOUT   DD SYSOUT=*
//TOOLIN   DD *
* 1. REKORDY WEJSCIOWE WG PRZEBIEGU I TYPU
  OCCUR FROM(DCOLIN) LIST(RPTIN) -
    TITLE('DCOLLECT - REKORDY WEJSCIOWE') -
    DATE TIME PAGE BLANK -
    HEADER('System')   ON(DCUSYSID) -
    HEADER('Data')     ON(DCUDATE) -
    HEADER('Czas')     ON(DCUTIME) -
    HEADER('Typ')      ON(DCURCTYP) -
    HEADER('Rekordow') ON(VALCNT)
* 2. LACZENIE BEZ DUPLIKATOW
  SORT FROM(DCOLIN) USING(MRG1)
* 3. REKORDY WYNIKOWE (PUSTY WYNIK - RC 12)
  COUNT FROM(DCOLOUT) EMPTY RC12
  OCCUR FROM(DCOLOUT) LIST(RPTOUT) -
    TITLE('DCOLLECT - REKORDY PO USUNIECIU DUPLIKATOW') -
    DATE TIME PAGE BLANK -
    HEADER('System')   ON(DCUSYSID) -
    HEADER('Data')     ON(DCUDATE) -
    HEADER('Czas')     ON(DCUTIME) -
    HEADER('Typ')      ON(DCURCTYP) -
    HEADER('Rekordow') ON(VALCNT)
/*
//MRG1CNTL DD *,SYMBOLS=JCLONLY
* POLA ROBOCZE ZA RDW (SYMBOLE N_ W DCRMRG), ORYGINAL OD KOL. 125:
*   5 TYP, 7 NAZWA (44), 51 WOLUMEN (6), 57 DATA I CZAS PRZEBIEGU,
*   65 DRUGA CZESC KLUCZA (44), 109 MIEJSCE NA PUSH (16)
* KAZDY TYP MA WLASNY KLUCZ; NIEPODANE KOLUMNY = SPACJE
* DEFINICJE SMS MAJA NAZWE W TYM SAMYM MIEJSCU (DDCNMFLD)
  INREC IFTHEN=(WHEN=(DCURCTYP,EQ,DCUDATAT),
          BUILD=(1,4,5:DCURCTYP,7:DCDDSNAM,51:&KVOL,
                 57:DCUDATE,61:DCUTIME,65:DCDVOLSR,125:5)),
        IFTHEN=(WHEN=(DCURCTYP,EQ,DCUASSOC),
          BUILD=(1,4,5:DCURCTYP,7:DCADSNAM,
                 57:DCUDATE,61:DCUTIME,65:DCAASSOC,125:5)),
        IFTHEN=(WHEN=(DCURCTYP,EQ,UKTMIGR),
          BUILD=(1,4,5:DCURCTYP,7:UMDSNAM,
                 57:DCUDATE,61:DCUTIME,125:5)),
        IFTHEN=(WHEN=(DCURCTYP,EQ,UKTBACK),
          BUILD=(1,4,5:DCURCTYP,7:UBDSNAM,
                 57:DCUDATE,61:DCUTIME,65:UBBDATE,125:5)),
        IFTHEN=(WHEN=(DCURCTYP,EQ,DCUVULUT),
          BUILD=(1,4,5:DCURCTYP,7:DCVVOLSR,
                 57:DCUDATE,61:DCUTIME,125:5)),
        IFTHEN=(WHEN=(DCURCTYP,EQ,UKCDASD),
          BUILD=(1,4,5:DCURCTYP,7:UCVOLSR,13:UCCOLDT,
                 57:DCUDATE,61:DCUTIME,125:5)),
        IFTHEN=(WHEN=(DCURCTYP,EQ,UKCTAPE),
          BUILD=(1,4,5:DCURCTYP,7:UTSTYPE,
                 57:DCUDATE,61:DCUTIME,125:5)),
        IFTHEN=(WHEN=(DCURCTYP,EQ,DCUDCDEF,OR,DCURCTYP,EQ,DCUSCDEF,OR,
                      DCURCTYP,EQ,DCUMCDEF,OR,DCURCTYP,EQ,DCUSGDEF,OR,
                      DCURCTYP,EQ,DCUVLDEF,OR,DCURCTYP,EQ,DCUAGDEF,OR,
                      DCURCTYP,EQ,DCUDRDEF,OR,DCURCTYP,EQ,DCULBDEF),
          BUILD=(1,4,5:DCURCTYP,7:DDCNMFLD,
                 57:DCUDATE,61:DCUTIME,125:5)),
        IFTHEN=(WHEN=NONE,
          BUILD=(1,4,5:DCURCTYP,57:DCUDATE,61:DCUTIME,125:5))
* W GRUPIE KLUCZA NAJNOWSZY PRZEBIEG PIERWSZY
  SORT FIELDS=(N_KEY,A,N_RUN,D,N_SUB,A)
* KAZDY REKORD DOSTAJE: PRZEBIEG PIERWSZEGO W GRUPIE KLUCZA I NUMER
* W GRUPIE (KLUCZ, PRZEBIEG, DRUGA CZESC)
  OUTREC IFTHEN=(WHEN=GROUP,KEYBEGIN=(N_KEY),PUSH=(N_NEW:N_RUN)),
         IFTHEN=(WHEN=GROUP,KEYBEGIN=(N_DUP),PUSH=(N_SEQ:SEQ=8))
* ZOSTAJE NAJNOWSZY PRZEBIEG, KAZDY REKORD RAZ; POLA ROBOCZE ZNIKAJA
  OUTFIL FNAMES=DCOLOUT,INCLUDE=(N_RUN,EQ,N_NEW,AND,N_SEQ,EQ,+1),
         BUILD=(1,4,125)
/*
