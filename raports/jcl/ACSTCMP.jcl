//ACSTCMP JOB (ACCT),'ACS TEST CMP',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//NQPROC   JCLLIB ORDER=(SYS1.SACBCNTL)
//*-------------------------------------------------------------------
//* TESTY ACS 4/5: TEST ZMIENIONYCH RUTYN I POROWNANIE Z BAZA
//*
//* WEJSCIE : ZRODLA ZMIENIONYCH RUTYN ACS (ACSNEW)
//*           TESTBED I BASELIST Z JOBA ACSTGEN (LUB ACSTACC)
//* WYNIK   : NEWLIST  - LISTING TESTU NA ZMIENIONYCH RUTYNACH
//*           CMPLIST  - POROWNANIE: TESTY, KTORYCH WYNIK (DC/SC/MC/
//*                      SG) ROZNI SIE OD OCZEKIWANEGO (= BAZOWEGO)
//*           EXCPPDS  - TESTY-WYJATKI
//*           XREFLIST - LISTING ROZSZERZONY (DSN, UNIT, ROZMIAR...)
//*           WYDRUKI W SYSOUT: TRANSLATE, VALIDATE, CMPLIST, XREFLIST
//*
//* JAK CZYTAC: KAZDY WYJATEK TO REPREZENTANT GRUPY. CALA GRUPA
//* ZMIENILABY KLASY/SG TAK SAMO - JEJ ZBIORY SA W ZBIORZE GRUPY
//* Z ACSREPR (KOL 46-89 = REPREZENTANT). WYJATKI MAJA BYC TYLKO
//* TAM, GDZIE ZMIANA BYLA ZAMIERZONA. GDY WSZYSTKO SIE ZGADZA,
//* JOB ACSTACC ZAPISUJE NOWE WYNIKI JAKO OCZEKIWANE.
//*
//* PARAMETRY (SET):
//*   PFX     - PREFIKS TSO (PROFILE PREFIX). ZBIORY NAVIQUEST
//*             PODAWANE BEZ APOSTROFOW = PFX.NAZWA
//*   NQPLIB  - PANELE ISMF/NAVIQUEST (PLIB1 W ACBJBAOB)
//*   ISPTABL - TABELE ISPF UZYTKOWNIKA (TABL2 W ACBJBAOB; ZBIOR
//*             MUSI ISTNIEC, DCB JAK SYS1.DGTTLIB)
//*   ACSNEW  - PDS ZE ZMIENIONYMI RUTYNAMI ACS (PELNA NAZWA)
//*   ACSDC, ACSSC, ACSMC, ACSSG - MEMBERY RUTYN
//*   SCDSNEW - SCDS TESTOWY (PELNA NAZWA) - KOPIA KONFIGURACJI,
//*             DO KTOREJ TLUMACZONE SA RUTYNY. NIGDY SCDS AKTYWNY
//*   TRLIST, VALLIST - LISTINGI TRANSLATE (TRLIST.DC/.SC/.MC/.SG)
//*             I VALIDATE (BEZ PFX)
//*   TESTBED, BASELIST, NEWLIST, CMPLIST, EXCPPDS, XREFLIST - NAZWY
//*             BEZ PFX (TESTBED, BASELIST, CMPLIST, EXCPPDS - JAK
//*             W ACSTGEN)
//*   XCPSPC  - SPACE PDS WYJATKOW (SCIEZKI PRIM,SEC,BLOKI KATALOGU)
//*
//* KROKI:
//*   TRDC, TRSC, TRMC, TRSG - ACBQBAO1: TRANSLATE RUTYN Z ACSNEW
//*             DO SCDSNEW
//*   VALID   - ACBQBAO2: WALIDACJA SCDSNEW
//*   PRTVAL  - DRUK LISTINGU VALIDATE
//*   PRTTR   - DRUK LISTINGOW TRANSLATE
//*   TESTNEW - ACBQBAIA: TESTY Z TESTBED NA SCDSNEW -> NEWLIST
//*   CMPNEW  - ACBQBAC1: BASELIST / NEWLIST -> CMPLIST, EXCPPDS
//*   XREF    - ACBQBAX1: LISTING ROZSZERZONY Z NEWLIST
//*   PRTCMP  - DRUK CMPLIST I XREFLIST
//* RUTYNY JUZ PRZETLUMACZONE W ISMF (7.2/7.3): URUCHOM OD TESTU -
//* RESTART=TESTNEW.STEP1 NA KARCIE JOB.
//* WARUNKI: VALID I TESTNEW POMIJANE, GDY WCZESNIEJSZY KROK MA RC > 4
//* (BLAD W RUTYNIE); KROKI PO TESCIE - GDY RC > 8.
//*
//* PROCEDURA ACBJBAOB Z SYS1.SACBCNTL (JCLLIB PONIZEJ). PRZYKLADY
//* IBM: ACBJBAG1, ACBJBAIC, ACBJBAC1, ACBJBAC2, ACBJBAX1, ACBJBAU2.
//*-------------------------------------------------------------------
//* EXPORT: BEZ NIEGO SYMBOLS=JCLONLY NIE PODSTAWIA &PFX ITD.
//* W DANYCH IN-STREAM (SYSTSIN). MUSI BYC PRZED SET.
//         EXPORT SYMLIST=(PFX,ACSNEW,ACSDC,ACSSC,ACSMC,ACSSG,
//             SCDSNEW,TRLIST,VALLIST,TESTBED,BASELIST,NEWLIST,
//             CMPLIST,EXCPPDS,XREFLIST,XCPSPC)
//         SET PFX=HLQ
//         SET ACSNEW='HLQ.ACS.SOURCE.NEW'
//         SET ACSDC=DATACLAS
//         SET ACSSC=STORCLAS
//         SET ACSMC=MGMTCLAS
//         SET ACSSG=STORGRP
//         SET SCDSNEW='HLQ.SMS.SCDS.TEST'
//         SET TRLIST='ACSTEST.TRAN'
//         SET VALLIST='ACSTEST.VALID.LIST'
//         SET TESTBED='ACSTEST.TESTBED'
//         SET BASELIST='ACSTEST.BASE.LIST'
//         SET NEWLIST='ACSTEST.NEW.LIST'
//         SET CMPLIST='ACSTEST.CMP.LIST'
//         SET EXCPPDS='ACSTEST.EXCP'
//         SET XREFLIST='ACSTEST.XREF.LIST'
//         SET XCPSPC='15,15,100'
//         SET NQPLIB='SYS1.DGTPLIB'
//         SET ISPTABL='HLQ.TEST.ISPTABL'
//*
//* TRANSLATE 4 RUTYN DO SCDS TESTOWEGO - KAZDA W OSOBNYM KROKU
//* (RC KROKU TSO = RC OSTATNIEJ KOMENDY)
//TRDC     EXEC ACBJBAOB,PLIB1=&NQPLIB,TABL2=&ISPTABL
//SYSTSIN  DD *,SYMBOLS=JCLONLY
PROFILE PREFIX(&PFX)
DEL &TRLIST..DC
ISPSTART CMD(ACBQBAO1 +
ACSSRC('&ACSNEW') +
MEMBER(&ACSDC) +
SCDSNAME('&SCDSNEW') +
LISTNAME(&TRLIST..DC) +
UPDHLVLSCDS()) +
NEWAPPL(DGT) BATSCRW(132) BATSCRD(27) BREDIMAX(3) BDISPMAX(99999999)
/*
//*
//TRSC     EXEC ACBJBAOB,PLIB1=&NQPLIB,TABL2=&ISPTABL
//SYSTSIN  DD *,SYMBOLS=JCLONLY
PROFILE PREFIX(&PFX)
DEL &TRLIST..SC
ISPSTART CMD(ACBQBAO1 +
ACSSRC('&ACSNEW') +
MEMBER(&ACSSC) +
SCDSNAME('&SCDSNEW') +
LISTNAME(&TRLIST..SC) +
UPDHLVLSCDS()) +
NEWAPPL(DGT) BATSCRW(132) BATSCRD(27) BREDIMAX(3) BDISPMAX(99999999)
/*
//*
//TRMC     EXEC ACBJBAOB,PLIB1=&NQPLIB,TABL2=&ISPTABL
//SYSTSIN  DD *,SYMBOLS=JCLONLY
PROFILE PREFIX(&PFX)
DEL &TRLIST..MC
ISPSTART CMD(ACBQBAO1 +
ACSSRC('&ACSNEW') +
MEMBER(&ACSMC) +
SCDSNAME('&SCDSNEW') +
LISTNAME(&TRLIST..MC) +
UPDHLVLSCDS()) +
NEWAPPL(DGT) BATSCRW(132) BATSCRD(27) BREDIMAX(3) BDISPMAX(99999999)
/*
//*
//TRSG     EXEC ACBJBAOB,PLIB1=&NQPLIB,TABL2=&ISPTABL
//SYSTSIN  DD *,SYMBOLS=JCLONLY
PROFILE PREFIX(&PFX)
DEL &TRLIST..SG
ISPSTART CMD(ACBQBAO1 +
ACSSRC('&ACSNEW') +
MEMBER(&ACSSG) +
SCDSNAME('&SCDSNEW') +
LISTNAME(&TRLIST..SG) +
UPDHLVLSCDS()) +
NEWAPPL(DGT) BATSCRW(132) BATSCRD(27) BREDIMAX(3) BDISPMAX(99999999)
/*
//*
//* DRUK LISTINGOW TRANSLATE (TAKZE PRZY BLEDZIE W RUTYNIE)
//PRTTR    EXEC PGM=IEBGENER,COND=EVEN
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DISP=SHR,DSN=&PFX..&TRLIST..DC
//         DD DISP=SHR,DSN=&PFX..&TRLIST..SC
//         DD DISP=SHR,DSN=&PFX..&TRLIST..MC
//         DD DISP=SHR,DSN=&PFX..&TRLIST..SG
//SYSUT2   DD SYSOUT=*
//*
//* WALIDACJA SCDS TESTOWEGO (WSZYSTKIE RUTYNY)
//VALID    EXEC ACBJBAOB,PLIB1=&NQPLIB,TABL2=&ISPTABL,
//             COND=(4,LT)
//SYSTSIN  DD *,SYMBOLS=JCLONLY
PROFILE PREFIX(&PFX)
DEL &VALLIST
ISPSTART CMD(ACBQBAO2 +
SCDSNAME('&SCDSNEW') +
TYPE(*) +
LISTNAME(&VALLIST) +
UPDHLVLSCDS()) +
NEWAPPL(DGT) BATSCRW(132) BATSCRD(27) BREDIMAX(3) BDISPMAX(99999999)
/*
//*
//* DRUK LISTINGU VALIDATE (TAKZE PRZY BLEDZIE; POMIJANY, GDY VALID
//* SIE NIE WYKONAL)
//PRTVAL   EXEC PGM=IEBGENER,
//             COND=((4,LT,TRDC.STEP1),(4,LT,TRSC.STEP1),
//             (4,LT,TRMC.STEP1),(4,LT,TRSG.STEP1),EVEN)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DISP=SHR,DSN=&PFX..&VALLIST
//SYSUT2   DD SYSOUT=*
//*
//* TESTY Z TESTBED NA ZMIENIONYCH RUTYNACH -> NEWLIST
//TESTNEW  EXEC ACBJBAOB,PLIB1=&NQPLIB,TABL2=&ISPTABL,
//             COND=(4,LT)
//SYSTSIN  DD *,SYMBOLS=JCLONLY
PROFILE PREFIX(&PFX)
DEL &NEWLIST
ISPSTART CMD(ACBQBAIA +
SCDSNAME('&SCDSNEW') +
TESTBED(&TESTBED) MEMBER(*) +
LISTNAME(&NEWLIST) +
DC(Y) SC(Y) MC(Y) SG(Y)) +
NEWAPPL(DGT) BATSCRW(132) BATSCRD(27) BREDIMAX(3) BDISPMAX(99999999)
/*
//*
//* POROWNANIE Z BAZA: WYJATKI = WYNIK INNY NIZ OCZEKIWANY
//CMPNEW   EXEC ACBJBAOB,PLIB1=&NQPLIB,TABL2=&ISPTABL,
//             COND=(8,LT)
//SYSTSIN  DD *,SYMBOLS=JCLONLY
PROFILE PREFIX(&PFX)
DEL &CMPLIST
DEL &EXCPPDS
ISPSTART CMD(%ACBQBAC1 +
BASELIST(&BASELIST) +
NEWLIST(&NEWLIST) +
TESTBED(&TESTBED) +
RSLTDSN(&CMPLIST) +
XCPTPDS(&EXCPPDS) +
XCPSPACE(&XCPSPC)) +
BATSCRW(132) BATSCRD(27) BREDIMAX(3) BDISPMAX(99999999)
/*
//*
//* LISTING ROZSZERZONY (DANE Z TESTBED) - POMOC PRZY ANALIZIE
//XREF     EXEC ACBJBAOB,PLIB1=&NQPLIB,TABL2=&ISPTABL,
//             COND=(8,LT)
//SYSTSIN  DD *,SYMBOLS=JCLONLY
PROFILE PREFIX(&PFX)
DEL &XREFLIST
%ACBQBAX1 +
ACSDSN(&NEWLIST) +
XREFDSN(&XREFLIST) +
XREFSPC() +
DSNINFO(Y) +
UNITINFO(Y) +
SIZEINFO(Y) +
EXPTINFO(Y) +
JOBINFO(Y) +
PGMINFO(Y)
/*
//*
//PRTCMP   EXEC PGM=IEBGENER,COND=(8,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DISP=SHR,DSN=&PFX..&CMPLIST
//         DD DISP=SHR,DSN=&PFX..&XREFLIST
//SYSUT2   DD SYSOUT=*
