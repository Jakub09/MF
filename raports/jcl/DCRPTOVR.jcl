//DCRPTOVR JOB (ACCT),'DCOLLECT OVERALLOC',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*-------------------------------------------------------------------
//* RAPORT 5: ZBIORY Z DUZA ALOKACJA I MALYM UZYCIEM
//*           (NP. ALOKACJA 315 TRK, UZYCIE 1 TRK LUB MNIEJ)
//*
//* WEJSCIE : WYNIK IDCAMS DCOLLECT (UZYWANE SA REKORDY TYPU 'D')
//* SYMBOLE : DCOL32.SYM (HEADER, TYPED) + DCRWORK, DCROVR (RPTSYM)
//* WYNIK   : DD RPT5  - LISTA ZBIOROW (WG NAZWY)
//*           DD RPT5S - PODSUMOWANIE WG DATA CLASS
//*
//* PARAMETRY (SET):
//*   ALTRK - PROG ALOKACJI W SCIEZKACH (3390)
//*   ALOP  - OPERATOR DLA ALOKACJI: EQ NE LT LE GT GE (DOMYSLNIE EQ)
//*   USTRK - PROG UZYCIA W SCIEZKACH
//*   USOP  - OPERATOR DLA UZYCIA (DOMYSLNIE LE)
//*   ZBIOR W RAPORCIE, GDY: ALOK_TRK ALOP ALTRK I UZYC_TRK USOP USTRK
//*   NP. ALOP=GE,ALTRK=315 - ALOKACJA 315 TRK I WIECEJ
//*
//* - SCIEZKI: ALOKACJA - ROUND(KB * 1024 / 56664),
//*            UZYCIE   - W GORE (KB * 1024 / 56664), 0 KB = 0 TRK
//* - WOLNE MB = ALOKACJA - UZYCIE
//* - ZBIOR WIELOWOLUMENOWY LICZONY RAZ (SUMA ZE WSZYSTKICH VOLUMENOW),
//*   KOLUMNA 'VOL' = PIERWSZY WOLUMEN
//* - MC/SC/DC NA WYDRUKU OBCIETE DO 8 ZNAKOW (PELNE NAZWY W OVRL)
//* - DATY W FORMACIE RRRRDDD (0 = BRAK)
//* - VSAM: KOMPONENTY (.DATA/.INDEX) LICZONE JAKO OSOBNE ZBIORY
//*-------------------------------------------------------------------
//* EXPORT: BEZ NIEGO SYMBOLS=JCLONLY NIE PODSTAWIA &ALTRK ITD.
//* W DANYCH IN-STREAM (SYMNAMES, KARTY, TOOLIN). MUSI BYC PRZED SET.
//         EXPORT SYMLIST=(ALTRK,ALOP,USTRK,USOP)
//         SET DCOLDSN='HLQ.DCOLLECT.OUTPUT'
//         SET SYMLIB='HLQ.DCOL32.SYM'
//         SET RPTSYM=&SYMLIB    BIBLIOTEKA DCRWORK/DCROVR
//         SET ALTRK=315
//         SET ALOP=EQ
//         SET USTRK=1
//         SET USOP=LE
//*
//RPTOVR   EXEC PGM=ICETOOL
//TOOLMSG  DD SYSOUT=*
//DFSMSG   DD SYSOUT=*
//SYMNOUT  DD SYSOUT=*
//SYMNAMES DD DISP=SHR,DSN=&SYMLIB(HEADER)
//         DD DISP=SHR,DSN=&SYMLIB(TYPED)
//         DD DISP=SHR,DSN=&RPTSYM(DCRWORK)
//         DD DISP=SHR,DSN=&RPTSYM(DCROVR)
//         DD *,SYMBOLS=JCLONLY
* PARAMETRY Z JCL (SET)
O_PALTRK,+&ALTRK
O_PUSTRK,+&USTRK
//DCOLIN   DD DISP=SHR,DSN=&DCOLDSN
//OVRL     DD DSN=&&OVRL,DISP=(NEW,DELETE,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(5,50),RLSE)
//OVSUM    DD DSN=&&OVSUM,DISP=(NEW,DELETE,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(1,5),RLSE)
//RPT5     DD SYSOUT=*
//RPT5S    DD SYSOUT=*
//TOOLIN   DD *,SYMBOLS=JCLONLY
* 1. REKORDY 'D' -> JEDEN REKORD NA ZBIOR, SCIEZKI, FILTR (OVRL)
  SORT FROM(DCOLIN) USING(EXT1)
* 2. LISTA ZBIOROW
  DISPLAY FROM(OVRL) LIST(RPT5) -
    TITLE('ALOK &ALOP &ALTRK TRK I UZYCIE &USOP &USTRK TRK') -
    DATE TIME PAGE BLANK WIDTH(200) -
    HEADER('Zbior')      ON(V_DSNAM) -
    HEADER('MC')         ON(V_MGTC8) -
    HEADER('SC')         ON(V_STGC8) -
    HEADER('DC')         ON(V_DATC8) -
    HEADER('Vol')        ON(V_VOLSR) -
    HEADER('Alok TRK')   ON(V_TRKALL) -
    HEADER('Uzyw TRK')   ON(V_TRKUSE) -
    HEADER('Alok MB')    ON(V_ALLMB) -
    HEADER('Wolne MB')   ON(V_FREMB) -
    HEADER('Utworzony')  ON(V_CREDT) -
    HEADER('Ost.uzycie') ON(V_LSTRF)
* 3. PODSUMOWANIE WG DATA CLASS (OVSUM)
  SORT FROM(OVRL) TO(OVSUM) USING(DCS1)
  DISPLAY FROM(OVSUM) LIST(RPT5S) -
    TITLE('WG DC: ALOK &ALOP &ALTRK, UZYCIE &USOP &USTRK TRK') -
    DATE TIME PAGE BLANK WIDTH(133) -
    HEADER('Data class')     ON(Y_DATCL) -
    HEADER('Liczba zbiorow') ON(Y_COUNT) -
    HEADER('Alokowane MB')   ON(Y_ALLMB) -
    HEADER('Wolne MB')       ON(Y_FREMB) -
    TOTAL('RAZEM')
/*
//EXT1CNTL DD *,SYMBOLS=JCLONLY
* TYLKO REKORDY AKTYWNYCH ZBIOROW (TYP 'D')
  INCLUDE COND=(DCURCTYP,EQ,DCUDATAT)
* UKLAD ROBOCZY (W_* JAK W INNYCH RAPORTACH + O_*)
* + WYBOR POLA PRZESTRZENI: 63-BIT / 31-BIT / 0
  INREC IFTHEN=(WHEN=INIT,
          BUILD=(1,4,5:ZD15_0,20:ZD15_0,35:DCDMGTCL,65:DCDDSNAM,
                 109:DCDFLAG2,110:DCDFLAG5,111:DCDALLSP,115:DCDUSESP,
                 119:DCDALLSX,127:DCDUSESX,
                 135:DCDSTGCL,165:DCDDATCL,195:DCDVOLSR,
                 201:DCDCREDT,205:DCDLSTRF)),
        IFTHEN=(WHEN=(W_FLAG5,EQ,DCDALLFX),
          OVERLAY=(5:W_ALLSX,TO=ZD,LENGTH=15),HIT=NEXT),
        IFTHEN=(WHEN=(W_FLAG5,NE,DCDALLFX,AND,W_FLAG2,EQ,DCDALLFG),
          OVERLAY=(5:W_ALLSP,TO=ZD,LENGTH=15),HIT=NEXT),
        IFTHEN=(WHEN=(W_FLAG5,EQ,DCDUSEFX),
          OVERLAY=(20:W_USESX,TO=ZD,LENGTH=15),HIT=NEXT),
        IFTHEN=(WHEN=(W_FLAG5,NE,DCDUSEFX,AND,W_FLAG2,EQ,DCDUSEFG),
          OVERLAY=(20:W_USESP,TO=ZD,LENGTH=15))
* ZBIOR WIELOWOLUMENOWY -> JEDEN REKORD, PRZESTRZEN ZSUMOWANA
  SORT FIELDS=(W_DSNAM,A)
  SUM FIELDS=(W_ALLKB,W_USEKB)
* PO SUMOWANIU: SCIEZKI I WOLNE KB
  OUTREC OVERLAY=(209:(W_ALLKB,MUL,+1024,ADD,+28332),DIV,+56664,
                      TO=ZD,LENGTH=15,
                  224:(W_USEKB,MUL,+1024,ADD,+56663),DIV,+56664,
                      TO=ZD,LENGTH=15,
                  239:W_ALLKB,SUB,W_USEKB,TO=ZD,LENGTH=15)
* FILTR WG PARAMETROW, VB -> FB 214
  OUTFIL FNAMES=OVRL,VTOF,
    INCLUDE=(O_TRKALL,&ALOP,O_PALTRK,AND,O_TRKUSE,&USOP,O_PUSTRK),
    BUILD=(1:W_DSNAM,45:W_MGTCL,75:O_STGCL,105:O_DATCL,
           135:O_VOLSR,141:O_CREDT,145:O_LSTRF,
           149:O_TRKALL,TO=ZD,LENGTH=9,
           158:O_TRKUSE,TO=ZD,LENGTH=9,
           167:(W_ALLKB,ADD,+512),DIV,+1024,TO=ZD,LENGTH=9,
           176:(O_FREKB,ADD,+512),DIV,+1024,TO=ZD,LENGTH=9,
           185:W_ALLKB,200:O_FREKB)
/*
//DCS1CNTL DD *
  INREC IFTHEN=(WHEN=INIT,
          BUILD=(1:V_DATCL,31:ZD15_1,46:V_ALLKB,61:V_FREKB)),
        IFTHEN=(WHEN=(Y_DATCL,EQ,C' '),
          OVERLAY=(1:C'(BRAK DC)'))
  SORT FIELDS=(Y_DATCL,A)
  SUM FIELDS=(Y_COUNT,Y_ALLKB,Y_FREKB)
* KB -> MB (ZAOKRAGLONE)
  OUTREC OVERLAY=(76:(Y_ALLKB,ADD,+512),DIV,+1024,
                     TO=ZD,LENGTH=15,
                  91:(Y_FREKB,ADD,+512),DIV,+1024,
                     TO=ZD,LENGTH=15)
/*
