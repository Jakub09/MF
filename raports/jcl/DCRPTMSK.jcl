//DCRPTMSK JOB (ACCT),'DCOLLECT MASK RPT',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*-------------------------------------------------------------------
//* RAPORT 2: ZAJETOSC WG MASEK ZBIOROW (2,3,4,5,6 KWALIFIKATOROW)
//*
//* WEJSCIE : WYNIK IDCAMS DCOLLECT (UZYWANE SA REKORDY TYPU 'D')
//* SYMBOLE : DCOL32.SYM (HEADER, TYPED) + DCRWORK, DCRMSK (RPTSYM)
//* WYNIK   : DD RPTL2 .. RPTL6 - OSOBNY WYDRUK DLA KAZDEGO POZIOMU
//*
//* - MASKA POZIOMU N = PIERWSZE N KWALIFIKATOROW + '.**'
//* - ZBIOR O MNIEJ NIZ N KWALIFIKATORACH NIE WCHODZI DO POZIOMU N
//* - ZBIOR WIELOWOLUMENOWY LICZONY RAZ (SUMA ZE WSZYSTKICH VOLUMENOW)
//* - ALOKACJA/UZYCIE: 63-BIT GDY WAZNE, INACZEJ 31-BIT, INACZEJ 0
//* - VSAM: KOMPONENTY (.DATA/.INDEX) LICZONE JAKO OSOBNE ZBIORY
//*-------------------------------------------------------------------
//         SET DCOLDSN='HLQ.DCOLLECT.OUTPUT'
//         SET SYMLIB='HLQ.DCOL32.SYM'
//         SET RPTSYM=&SYMLIB    BIBLIOTEKA DCRWORK/DCRMSK
//*
//RPTMSK   EXEC PGM=ICETOOL
//TOOLMSG  DD SYSOUT=*
//DFSMSG   DD SYSOUT=*
//SYMNOUT  DD SYSOUT=*
//SYMNAMES DD DISP=SHR,DSN=&SYMLIB(HEADER)
//         DD DISP=SHR,DSN=&SYMLIB(TYPED)
//         DD DISP=SHR,DSN=&RPTSYM(DCRWORK)
//         DD DISP=SHR,DSN=&RPTSYM(DCRMSK)
//DCOLIN   DD DISP=SHR,DSN=&DCOLDSN
//EXTR     DD DSN=&&EXTR,DISP=(NEW,DELETE,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(10,50),RLSE)
//PQ       DD DSN=&&PQ,DISP=(NEW,DELETE,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(10,50),RLSE)
//LVSUM    DD DSN=&&LVSUM,DISP=(NEW,DELETE,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(5,50),RLSE)
//RPTL2    DD SYSOUT=*
//RPTL3    DD SYSOUT=*
//RPTL4    DD SYSOUT=*
//RPTL5    DD SYSOUT=*
//RPTL6    DD SYSOUT=*
//TOOLIN   DD *
* 1. REKORDY 'D' -> JEDEN REKORD NA ZBIOR (EXTR)
  SORT FROM(DCOLIN) USING(EXT1)
* 2. ROZBICIE NAZWY NA KWALIFIKATORY 1-6 (PQ)
  COPY FROM(EXTR) TO(PQ) USING(PRSE)
* 3. POZIOMY 2-6: SUMY WG MASKI (LVSUM) I WYDRUK
  SORT FROM(PQ) TO(LVSUM) USING(LEV2)
  DISPLAY FROM(LVSUM) LIST(RPTL2) -
    TITLE('DCOLLECT - MASKI 2 KWALIFIKATOROW') -
    DATE TIME PAGE BLANK WIDTH(133) -
    HEADER('Maska')          ON(1,20,CH) -
    HEADER('Liczba zbiorow') ON(K_COUNT) -
    HEADER('Alokowane MB')   ON(K_ALLMB) -
    HEADER('Uzywane MB')     ON(K_USEMB) -
    TOTAL('RAZEM')
  SORT FROM(PQ) TO(LVSUM) USING(LEV3)
  DISPLAY FROM(LVSUM) LIST(RPTL3) -
    TITLE('DCOLLECT - MASKI 3 KWALIFIKATOROW') -
    DATE TIME PAGE BLANK WIDTH(133) -
    HEADER('Maska')          ON(1,29,CH) -
    HEADER('Liczba zbiorow') ON(K_COUNT) -
    HEADER('Alokowane MB')   ON(K_ALLMB) -
    HEADER('Uzywane MB')     ON(K_USEMB) -
    TOTAL('RAZEM')
  SORT FROM(PQ) TO(LVSUM) USING(LEV4)
  DISPLAY FROM(LVSUM) LIST(RPTL4) -
    TITLE('DCOLLECT - MASKI 4 KWALIFIKATOROW') -
    DATE TIME PAGE BLANK WIDTH(133) -
    HEADER('Maska')          ON(1,38,CH) -
    HEADER('Liczba zbiorow') ON(K_COUNT) -
    HEADER('Alokowane MB')   ON(K_ALLMB) -
    HEADER('Uzywane MB')     ON(K_USEMB) -
    TOTAL('RAZEM')
  SORT FROM(PQ) TO(LVSUM) USING(LEV5)
  DISPLAY FROM(LVSUM) LIST(RPTL5) -
    TITLE('DCOLLECT - MASKI 5 KWALIFIKATOROW') -
    DATE TIME PAGE BLANK WIDTH(133) -
    HEADER('Maska')          ON(1,47,CH) -
    HEADER('Liczba zbiorow') ON(K_COUNT) -
    HEADER('Alokowane MB')   ON(K_ALLMB) -
    HEADER('Uzywane MB')     ON(K_USEMB) -
    TOTAL('RAZEM')
  SORT FROM(PQ) TO(LVSUM) USING(LEV6)
  DISPLAY FROM(LVSUM) LIST(RPTL6) -
    TITLE('DCOLLECT - MASKI 6 KWALIFIKATOROW') -
    DATE TIME PAGE BLANK WIDTH(133) -
    HEADER('Maska')          ON(1,56,CH) -
    HEADER('Liczba zbiorow') ON(K_COUNT) -
    HEADER('Alokowane MB')   ON(K_ALLMB) -
    HEADER('Uzywane MB')     ON(K_USEMB) -
    TOTAL('RAZEM')
/*
//EXT1CNTL DD *
* TYLKO REKORDY AKTYWNYCH ZBIOROW (TYP 'D')
  INCLUDE COND=(DCURCTYP,EQ,DCUDATAT)
* UKLAD ROBOCZY + WYBOR POLA PRZESTRZENI: 63-BIT / 31-BIT / 0
  INREC IFTHEN=(WHEN=INIT,
          BUILD=(1,4,5:ZD15_0,20:ZD15_0,35:DCDMGTCL,65:DCDDSNAM,
                 109:DCDFLAG2,110:DCDFLAG5,111:DCDALLSP,115:DCDUSESP,
                 119:DCDALLSX,127:DCDUSESX)),
        IFTHEN=(WHEN=(W_FLAG5,EQ,DCDALLFX),
          OVERLAY=(5:W_ALLSX,TO=ZD,LENGTH=15),HIT=NEXT),
        IFTHEN=(WHEN=(W_FLAG5,NE,DCDALLFX,AND,W_FLAG2,EQ,DCDALLFG),
          OVERLAY=(5:W_ALLSP,TO=ZD,LENGTH=15),HIT=NEXT),
        IFTHEN=(WHEN=(W_FLAG5,EQ,DCDUSEFX),
          OVERLAY=(20:W_USESX,TO=ZD,LENGTH=15),HIT=NEXT),
        IFTHEN=(WHEN=(W_FLAG5,NE,DCDUSEFX,AND,W_FLAG2,EQ,DCDUSEFG),
          OVERLAY=(20:W_USESP,TO=ZD,LENGTH=15))
* ZBIOR WIELOWOLUMENOWY -> JEDEN REKORD, PRZESTRZEN ZSUMOWANA
  SORT FIELDS=(W_DSNAM,A)
  SUM FIELDS=(W_ALLKB,W_USEKB)
* VB -> FB 104
  OUTFIL FNAMES=EXTR,VTOF,BUILD=(5,104)
/*
//PRSECNTL DD *
* KWALIFIKATORY 1-6; FIXLEN=9 ZOSTAWIA SPACJE PO KAZDYM KWALIFIKATORZE
* (SEPARATOR DLA SQZ MID=C'.'). NAZWA JEST NA KONCU REKORDU, WIEC
* OSTATNI KWALIFIKATOR KONCZY SIE NA KONCU REKORDU.
  INREC PARSE=(%01=(ABSPOS=61,ENDBEFR=C'.',FIXLEN=9),
               %02=(ENDBEFR=C'.',FIXLEN=9),
               %03=(ENDBEFR=C'.',FIXLEN=9),
               %04=(ENDBEFR=C'.',FIXLEN=9),
               %05=(ENDBEFR=C'.',FIXLEN=9),
               %06=(ENDBEFR=C'.',FIXLEN=9)),
        BUILD=(1:%01,%02,%03,%04,%05,%06,55:X_ALLKB,70:X_USEKB)
/*
//*-------------------------------------------------------------------
//* LEVN: MASKA = KWALIFIKATORY 1..N + '**', SPACJE -> '.' (SQZ MID)
//*-------------------------------------------------------------------
//LEV2CNTL DD *
  INCLUDE COND=(P_Q2,NE,C' ')
  INREC IFTHEN=(WHEN=INIT,
          BUILD=(1:1,18,C'**',61:ZD15_1,76:P_ALLKB,91:P_USEKB)),
        IFTHEN=(WHEN=INIT,
          OVERLAY=(1:K_MASK,SQZ=(SHIFT=LEFT,MID=C'.')))
  SORT FIELDS=(K_MASK,A)
  SUM FIELDS=(K_COUNT,K_ALLKB,K_USEKB)
  OUTREC OVERLAY=(106:(K_ALLKB,ADD,+512),DIV,+1024,
                      TO=ZD,LENGTH=15,
                  121:(K_USEKB,ADD,+512),DIV,+1024,
                      TO=ZD,LENGTH=15)
/*
//LEV3CNTL DD *
  INCLUDE COND=(P_Q3,NE,C' ')
  INREC IFTHEN=(WHEN=INIT,
          BUILD=(1:1,27,C'**',61:ZD15_1,76:P_ALLKB,91:P_USEKB)),
        IFTHEN=(WHEN=INIT,
          OVERLAY=(1:K_MASK,SQZ=(SHIFT=LEFT,MID=C'.')))
  SORT FIELDS=(K_MASK,A)
  SUM FIELDS=(K_COUNT,K_ALLKB,K_USEKB)
  OUTREC OVERLAY=(106:(K_ALLKB,ADD,+512),DIV,+1024,
                      TO=ZD,LENGTH=15,
                  121:(K_USEKB,ADD,+512),DIV,+1024,
                      TO=ZD,LENGTH=15)
/*
//LEV4CNTL DD *
  INCLUDE COND=(P_Q4,NE,C' ')
  INREC IFTHEN=(WHEN=INIT,
          BUILD=(1:1,36,C'**',61:ZD15_1,76:P_ALLKB,91:P_USEKB)),
        IFTHEN=(WHEN=INIT,
          OVERLAY=(1:K_MASK,SQZ=(SHIFT=LEFT,MID=C'.')))
  SORT FIELDS=(K_MASK,A)
  SUM FIELDS=(K_COUNT,K_ALLKB,K_USEKB)
  OUTREC OVERLAY=(106:(K_ALLKB,ADD,+512),DIV,+1024,
                      TO=ZD,LENGTH=15,
                  121:(K_USEKB,ADD,+512),DIV,+1024,
                      TO=ZD,LENGTH=15)
/*
