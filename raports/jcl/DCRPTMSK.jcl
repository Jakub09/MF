  INCLUDE COND=(P_Q5,NE,C' ')
  INREC IFTHEN=(WHEN=INIT,
          BUILD=(1:1,45,C'**',61:ZD15_1,76:P_ALLKB,91:P_USEKB)),
        IFTHEN=(WHEN=INIT,
          OVERLAY=(1:K_MASK,SQZ=(SHIFT=LEFT,MID=C'.')))
  SORT FIELDS=(K_MASK,A)
  SUM FIELDS=(K_COUNT,K_ALLKB,K_USEKB)
  OUTREC OVERLAY=(106:(K_ALLKB,ADD,+512),DIV,+1024,
                      TO=ZD,LENGTH=15,
                  121:(K_USEKB,ADD,+512),DIV,+1024,
                      TO=ZD,LENGTH=15)
/*
//LEV6CNTL DD *
  INCLUDE COND=(P_Q6,NE,C' ')
  INREC IFTHEN=(WHEN=INIT,
          BUILD=(1:1,54,C'**',61:ZD15_1,76:P_ALLKB,91:P_USEKB)),
        IFTHEN=(WHEN=INIT,
          OVERLAY=(1:K_MASK,SQZ=(SHIFT=LEFT,MID=C'.')))
  SORT FIELDS=(K_MASK,A)
  SUM FIELDS=(K_COUNT,K_ALLKB,K_USEKB)
  OUTREC OVERLAY=(106:(K_ALLKB,ADD,+512),DIV,+1024,
                      TO=ZD,LENGTH=15,
                  121:(K_USEKB,ADD,+512),DIV,+1024,
                      TO=ZD,LENGTH=15)
/*
