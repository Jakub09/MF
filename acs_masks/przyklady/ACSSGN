PROC STORGRP
/*********************************************************************/
/* PRZYKLADOWA RUTYNA GRUPY PAMIECI - NOWA WERSJA: ARCHIWA DO SGARCH */
/*********************************************************************/
  FILTLIST ARCH INCLUDE(PROD.*.ARCH.**)

  SELECT
    WHEN (&DSN = &ARCH)
      SET &STORGRP = 'SGARCH'
    WHEN (&STORCLAS = 'SCBIG')
      SET &STORGRP = 'SGBIG1','SGBIG2'
    WHEN (&DSN(1) = 'TEST' | &DSN(1) = 'DEV')
      SET &STORGRP = 'SGTEST'
    WHEN (&NQUAL > 4 && &DSN(&NQUAL) = SYS*)
      SET &STORGRP = 'SGBATCH'
    OTHERWISE
      SET &STORGRP = 'SGPROD'
  END
END
