{
  "name": "acs-routines",
  "displayName": "ACS Routines (DFSMS)",
  "description": "Rutyny ACS (z/OS DFSMS): kolorowanie skladni, diagnostyka, konspekt, FILTLIST - definicje i odwolania, opisy zmiennych",
  "version": "0.1.0",
  "publisher": "mf-local",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./out/vscode/src/extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "acs",
        "aliases": [
          "ACS",
          "DFSMS ACS routine",
          "acs"
        ],
        "extensions": [
          ".acs"
        ],
        "firstLine": "^\\s*(/\\*.*\\*/\\s*)?[Pp][Rr][Oo][Cc]\\s+(\\d+\\s+)?&?(DATACLAS|STORCLAS|MGMTCLAS|STORGRP)\\b",
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "acs",
        "scopeName": "source.acs",
        "path": "./syntaxes/acs.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "ACS Routines",
      "properties": {
        "acs.maxColumn": {
          "type": "number",
          "default": 80,
          "minimum": 40,
          "maximum": 255,
          "description": "Najdluzsza dozwolona linia zrodla rutyny (ostrzezenie ACS250). 80 = rekord FB 80; 72, gdy kolumny 73-80 sa zajete."
        }
      }
    },
    "configurationDefaults": {
      "[acs]": {
        "editor.rulers": [
          72,
          80
        ],
        "editor.insertSpaces": true,
        "editor.tabSize": 2
      }
    }
  }
}
