{
  "comments": {
    "blockComment": [
      "/*",
      "*/"
    ]
  },
  "brackets": [
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "'",
      "close": "'",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "/*",
      "close": " */",
      "notIn": [
        "string"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "(",
      ")"
    ],
    [
      "'",
      "'"
    ]
  ],
  "wordPattern": "&?[A-Za-z0-9$@#_]+",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(DO|SELECT(\\s*\\(.*\\))?|WHEN\\s*\\(.*\\)|OTHERWISE|.*\\bTHEN|ELSE)\\s*(/\\*.*\\*/\\s*)?$",
    "decreaseIndentPattern": "^\\s*END\\b"
  }
}
