{
  "name": "acs-masks",
  "version": "0.1.0",
  "private": true,
  "description": "Maski DSN i przykladowe rutyny ACS z CSV DCOLLECT (na PC) + joby z/OS: DCOLLECT -> CSV, reprezentanci wg masek",
  "bin": {
    "acs-masks": "dist/src/cli.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "cli": "tsx src/cli.ts",
    "bundle": "node tools/pack.mjs"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
