{
  "name": "acs-masks",
  "version": "0.1.0",
  "private": true,
  "description": "Maski DSN, kontrola i emulacja rutyn ACS na CSV z DCOLLECT (na PC) + joby z/OS; parser ACS z ../../acs-vscode",
  "bin": {
    "acs-masks": "dist/src/cli.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "prebuild": "npm run lang:build --silent",
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "npm run lang:build --silent",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run lang:build --silent",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "cli": "tsx src/cli.ts",
    "bundle": "node tools/pack.mjs",
    "lang:build": "npm --prefix ../../acs-vscode run build --silent"
  },
  "dependencies": {
    "acs-routines": "file:../../acs-vscode",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
