//ACMCSV  JOB (ACCT),'ACS MASKI CSV',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*-------------------------------------------------------------------
//* ACS-MASKS 1/2: DCOLLECT -> CSV DLA SKRYPTU ACS-MASKS (NA PC)
//*
//* WEJSCIE : WYNIK IDCAMS DCOLLECT (REKORDY 'D', OPCJONALNIE 'A')
//* SYMBOLE : DCOL32.SYM (HEADER, TYPED, TYPEA) + ACMCSV (RPTSYM)
//* WYNIK   : CSVDSN - CSV (FB), SEPARATOR ';', WARTOSCI BEZ SPACJI:
//*   T;DSN;...   NAGLOWEK - NAZWY KOLUMN REKORDU D
//*   D;...       ZBIOR NA WOLUMENIE: NAZWA, VOLSER, NR WOLUMENU,
//*               DSORG I RECFM (HEX), LRECL, BLKSIZE, EKSTENTY,
//*               FLAGI 1/2/3/5 (HEX), ALOKACJA I UZYCIE KB (31-BIT,
//*               63-BIT), DATY UTWORZENIA, UZYCIA, WYGASNIECIA (PD
//*               JAKO HEX), SC, MC, DC, SG, JOB TWORZACY
//*   A;KOMPONENT;KLASTER;FLAGA - KOMPONENT VSAM -> KLASTER
//*   ZNACZENIE FLAG, WYBOR 31/63-BIT I SCIEZKI - W SKRYPCIE
//*   (SRC/DATASET.TS). ZBIOR WIELOWOLUMENOWY = KILKA LINII D.
//* TRANSFER NA PC: TEKSTOWO (FTP ASCII ALBO ICONV -F IBM-1047)
//*
//* PARAMETRY (SET):
//*   DCOLDSN - WYNIK DCOLLECT
//*   CSVDSN  - CSV WYNIKOWY (USUWANY NA POCZATKU)
//*   SYMLIB  - BIBLIOTEKA DCOL32 (HEADER, TYPED, TYPEA)
//*   RPTSYM  - BIBLIOTEKA SYMBOLI ACS-MASKS (ACMCSV, ACMREPR)
//*
//* KROKI: DELCSV - USUNIECIE CSV
//*        CSV    - DFSORT: REKORDY D I A -> CSV
//*-------------------------------------------------------------------
//         SET DCOLDSN='HLQ.DCOLLECT.OUTPUT'
//         SET CSVDSN='HLQ.ACSMASK.CSV'
//         SET SYMLIB='HLQ.DCOL32.SYM'
//         SET RPTSYM='HLQ.ACSMASK.SYM'
//*
//* USUNIECIE CSV Z POPRZEDNIEGO PRZEBIEGU (BRAK ZBIORU - RC 0)
//DELCSV   EXEC PGM=IEFBR14
//CSV      DD DSN=&CSVDSN,DISP=(MOD,DELETE),UNIT=SYSDA,SPACE=(TRK,0)
//*
//CSV      EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SYMNOUT  DD SYSOUT=*
//SYMNAMES DD DISP=SHR,DSN=&SYMLIB(HEADER)
//         DD DISP=SHR,DSN=&SYMLIB(TYPED)
//         DD DISP=SHR,DSN=&SYMLIB(TYPEA)
//         DD DISP=SHR,DSN=&RPTSYM(ACMCSV)
//SORTIN   DD DISP=SHR,DSN=&DCOLDSN
//* CSV: OK. 200 B NA REKORD D - PRZY DUZYM DCOLLECT ZWIEKSZ SPACE
//CSV      DD DSN=&CSVDSN,DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(50,200),RLSE)
//SYSIN    DD *
* TYLKO REKORDY 'D' (ZBIORY) I 'A' (KOMPONENT VSAM -> KLASTER)
  OPTION COPY
  INCLUDE COND=(DCURCTYP,EQ,DCUDATAT,OR,DCURCTYP,EQ,DCUASSOC)
* LINIA CSV W KOL. 5-400 (SPACJE USUWA SQZ W OUTFIL); KOLEJNOSC
* KOLUMN JAK W NAGLOWKU (HEADER1) I W SRC/DATASET.TS (DCOL_COLUMNS)
  INREC IFTHEN=(WHEN=(DCURCTYP,EQ,DCUDATAT),
          BUILD=(DCURDW,C'D;',DCDDSNAM,C';',DCDVOLSR,C';',
                 E_VOLSQ,EDIT=(IIIIT),C';',
                 DCDDSORG,HEX,C';',DCDRECRD,HEX,C';',
                 DCDLRECL,EDIT=(IIIIIT),C';',
                 DCDBKLNG,EDIT=(IIIIIT),C';',
                 DCDNMEXT,EDIT=(IIT),C';',
                 DCDFLAG1,HEX,C';',DCDFLAG2,HEX,C';',
                 DCDFLAG3,HEX,C';',DCDFLAG5,HEX,C';',
                 DCDALLSP,EDIT=(IIIIIIIIIIT),C';',
                 DCDUSESP,EDIT=(IIIIIIIIIIT),C';',
                 DCDALLSX,EDIT=(IIIIIIIIIIIIIIIIIIT),C';',
                 DCDUSESX,EDIT=(IIIIIIIIIIIIIIIIIIT),C';',
                 DCDCREDT,HEX,C';',DCDLSTRF,HEX,C';',
                 DCDEXPDT,HEX,C';',
                 DCDSTGCL,C';',DCDMGTCL,C';',DCDDATCL,C';',
                 DCDSTGRP,C';',DCDJBNMC,400:X)),
        IFTHEN=(WHEN=(DCURCTYP,EQ,DCUASSOC),
          BUILD=(DCURDW,C'A;',DCADSNAM,C';',DCAASSOC,C';',
                 DCAFLAG1,HEX,400:X))
* VB -> FB, BEZ SPACJI; NAGLOWEK BEZ ZNAKU STERUJACEGO (REMOVECC)
  OUTFIL FNAMES=CSV,VTOF,REMOVECC,
    HEADER1=(C'T;DSN;VOLSER;VOLSQ;DSORG;RECFM;LRECL;BLKSZ;NEXT;',
             C'FLAG1;FLAG2;FLAG3;FLAG5;ALLKB;USEKB;ALLKBX;USEKBX;',
             C'CREDT;LSTRF;EXPDT;SC;MC;DC;SG;CJOB'),
    BUILD=(E_CSV,SQZ=(SHIFT=LEFT))
/*
