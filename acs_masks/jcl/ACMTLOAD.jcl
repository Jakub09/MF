//ACMTLOAD JOB (ACCT),'ACS TESTY Z PC',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*-------------------------------------------------------------------
//* ACS-MASKS: TESTY ISMF WYGENEROWANE NA PC -> TESTBED (IEBUPDTE)
//* ALTERNATYWA DLA TESTOW Z DCOLLECT PRZEZ NAVIQUEST (ACMRSEL +
//* ACBQBAG1 W ACSTGEN) - TA DROGA ZOSTAJE.
//*
//* WEJSCIE : MASKLIB(ACMTEST) - ZE SKRYPTU "ACS-MASKS REPR --TESTS"
//*           (KATALOG OUT/ZOS), FB 80, FORMAT IEBUPDTE:
//*             ./ ADD NAME=ACM00001
//*             DESCRIPTION1:
//*             <MASKI / KWALIFIKATORY Z RUTYN PASUJACE DO DSN>
//*             DSN: <NAZWA ZBIORU>
//*             ACSENVIR: ALLOC
//*             ...
//*             ./ ENDUP
//* WYNIK   : TESTBED - PDS FB 80, JEDEN TEST NA MEMBER
//*
//* DALEJ: RAPORTS/JCL/ACSTGEN Z RESTART=TESTBAS NA KARCIE JOB (BEZ
//* KROKOW DELTB, ALLOCTB I GENTEST). TESTBED TU = &PFX..&TESTBED
//* W ACSTGEN. TESTBAS LICZY WYNIKI BAZOWE, UPDBAS ZAPISUJE JE JAKO
//* OCZEKIWANE.
//*
//* PARAMETRY (SET):
//*   MASKLIB - PDS FB 80 Z MEMBREM ACMTEST
//*   TESTBED - BIBLIOTEKA TESTOW (USUWANA I ZAKLADANA OD NOWA)
//*   TBCYL   - CYLINDRY TESTBED
//*   TBDIR   - BLOKI KATALOGU TESTBED (OK. 6 MEMBEROW NA BLOK;
//*             LICZBA TESTOW W RAPORCIE REPREZENTANCI.TXT)
//*
//* KROKI: DELTB - USUNIECIE STAREGO TESTBED
//*        LOAD  - IEBUPDTE PARM=NEW: MEMBERY Z ACMTEST -> TESTBED
//*-------------------------------------------------------------------
//         SET MASKLIB='HLQ.ACSMASK.CNTL'
//         SET TESTBED='HLQ.ACSTEST.TESTBED'
//         SET TBCYL=10
//         SET TBDIR=300
//*
//* USUNIECIE STAREGO TESTBED (BRAK ZBIORU - RC 0)
//DELTB    EXEC PGM=IEFBR14
//TB       DD DSN=&TESTBED,DISP=(MOD,DELETE),UNIT=SYSDA,SPACE=(TRK,0)
//*
//* NOWY TESTBED Z MEMBERAMI Z ACMTEST
//LOAD     EXEC PGM=IEBUPDTE,PARM=NEW
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DISP=SHR,DSN=&MASKLIB(ACMTEST)
//SYSUT2   DD DSN=&TESTBED,DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(&TBCYL,&TBCYL,&TBDIR)),
//            RECFM=FB,LRECL=80,BLKSIZE=0
