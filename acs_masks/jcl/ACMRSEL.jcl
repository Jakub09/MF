//ACMRSEL JOB (ACCT),'ACS REPREZENTANCI',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*-------------------------------------------------------------------
//* ACS-MASKS: REKORDY 'D' REPREZENTANTOW WYBRANYCH NA PC -> REPDCOL
//*
//* WEJSCIE : WYNIK IDCAMS DCOLLECT (TEN SAM, Z KTOREGO POWSTAL CSV)
//*           MASKLIB(ACMRLST) - LISTA REPREZENTANTOW ZE SKRYPTU
//*           "ACS-MASKS REPR" (KATALOG OUT/ZOS), FB 80:
//*             KOL  1-44 NAZWA ZBIORU Z REKORDU D
//*             KOL 46-51 WOLUMEN
//*             KOL 53-59 NUMER GRUPY (INFORMACYJNIE)
//* SYMBOLE : DCOL32.SYM (HEADER, TYPED) + ACMRSEL (RPTSYM)
//* WYNIK   : REPDCOL - DCOLLECT Z REKORDAMI 'D' REPREZENTANTOW
//*                     (WEJSCIE ACBQBAG1 W JOBIE ACSTGEN, RAPORTS/JCL)
//*           DD BRAK - POZYCJE LISTY BEZ REKORDU W DCOLLECT (POWINNO
//*                     BYC PUSTE; INACZEJ CSV I DCOLLECT SA Z ROZNYCH
//*                     PRZEBIEGOW)
//*
//* PARAMETRY (SET):
//*   DCOLDSN - WYNIK DCOLLECT
//*   MASKLIB - PDS FB 80 Z MEMBREM ACMRLST
//*   REPDCOL - ZBIOR WYNIKOWY (USUWANY NA POCZATKU)
//*   SYMLIB  - BIBLIOTEKA DCOL32 (HEADER, TYPED)
//*   RPTSYM  - BIBLIOTEKA SYMBOLI ACS-MASKS (ACMRSEL)
//*
//* KROKI: DELOUT - USUNIECIE REPDCOL
//*        SEL    - DFSORT JOINKEYS: REKORDY D Z LISTY -> REPDCOL
//*        BRAK   - DFSORT JOINKEYS: POZYCJE LISTY BEZ REKORDU D
//*-------------------------------------------------------------------
//         SET DCOLDSN='HLQ.DCOLLECT.OUTPUT'
//         SET MASKLIB='HLQ.ACSMASK.CNTL'
//         SET REPDCOL='HLQ.ACSMASK.DCOLREP'
//         SET SYMLIB='HLQ.DCOL32.SYM'
//         SET RPTSYM='HLQ.ACSMASK.SYM'
//*
//* USUNIECIE WYNIKU POPRZEDNIEGO PRZEBIEGU (BRAK ZBIORU - RC 0)
//DELOUT   EXEC PGM=IEFBR14
//REPDCOL  DD DSN=&REPDCOL,DISP=(MOD,DELETE),UNIT=SYSDA,SPACE=(TRK,0)
//*
//* REKORDY D, KTORYCH NAZWA I WOLUMEN SA NA LISCIE
//SEL      EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SYMNOUT  DD SYSOUT=*
//SYMNAMES DD DISP=SHR,DSN=&SYMLIB(HEADER)
//         DD DISP=SHR,DSN=&SYMLIB(TYPED)
//         DD DISP=SHR,DSN=&RPTSYM(ACMRSEL)
//DCOLIN   DD DISP=SHR,DSN=&DCOLDSN
//LIST     DD DISP=SHR,DSN=&MASKLIB(ACMRLST)
//SORTOUT  DD DSN=&REPDCOL,DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(1,10),RLSE)
//JNF1CNTL DD *
* F1 (DCOLLECT): TYLKO REKORDY 'D'
  INCLUDE COND=(DCURCTYP,EQ,DCUDATAT)
/*
//SYSIN    DD *
* REKORD VB DCOLLECT BEZ ZMIAN (RDW + DANE OD KOL. 5)
  JOINKEYS F1=DCOLIN,FIELDS=(DCDDSNAM,A,DCDVOLSR,A)
  JOINKEYS F2=LIST,FIELDS=(L_DSN,A,L_VOL,A)
  REFORMAT FIELDS=(F1:DCURDW,F1:5)
  OPTION COPY
/*
//*
//* KONTROLA: POZYCJE LISTY, DLA KTORYCH NIE MA REKORDU D
//* (WYKONYWANY TAKZE PO BLEDZIE KROKU SEL - WYNIK POMAGA W DIAGNOZIE)
//BRAK     EXEC PGM=SORT,COND=EVEN
//SYSOUT   DD SYSOUT=*
//SYMNOUT  DD SYSOUT=*
//SYMNAMES DD DISP=SHR,DSN=&SYMLIB(HEADER)
//         DD DISP=SHR,DSN=&SYMLIB(TYPED)
//         DD DISP=SHR,DSN=&RPTSYM(ACMRSEL)
//DCOLIN   DD DISP=SHR,DSN=&DCOLDSN
//LIST     DD DISP=SHR,DSN=&MASKLIB(ACMRLST)
//SORTOUT  DD SYSOUT=*,DCB=(RECFM=FB,LRECL=80)
//JNF2CNTL DD *
* F2 (DCOLLECT): TYLKO REKORDY 'D'
  INCLUDE COND=(DCURCTYP,EQ,DCUDATAT)
/*
//SYSIN    DD *
  JOINKEYS F1=LIST,FIELDS=(L_DSN,A,L_VOL,A)
  JOINKEYS F2=DCOLIN,FIELDS=(DCDDSNAM,A,DCDVOLSR,A)
  JOIN UNPAIRED,F1,ONLY
  REFORMAT FIELDS=(F1:L_REC)
  OPTION COPY
/*
